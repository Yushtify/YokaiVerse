---
import { transitionEnabledOnThisPage } from "astro:transitions/client";
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";
import { treeifyError } from "astro:schema";

interface Props {
    givenPositionTo?: "horizontal" | "vertical";
    givenPosition?: "start" | "center" | "end";
    givenTitle: string;
    givenState: boolean;
    givenID: string;
    groupName: string;
    canDisabled?: boolean;
    dataLang: string;
    givenSymbol?: string;
}

const {
    givenPositionTo,
    givenPosition,
    givenTitle,
    givenState,
    givenID,
    groupName,
    canDisabled = true,
    dataLang,
    givenSymbol,
} = Astro.props;

let validRounded = "rounded-3xl";
if (givenPosition && givenPositionTo) {
    if (givenPositionTo === "horizontal") {
        if (givenPosition === "start") {
            validRounded = "rounded-l-3xl rounded-r-xl";
        } else if (givenPosition === "end") {
            validRounded = "rounded-l-xl rounded-r-3xl";
        } else if (givenPosition === "center") {
            validRounded = "rounded-xl";
        }
    } else if (givenPositionTo === "vertical") {
        if (givenPosition === "start") {
            validRounded = "rounded-t-3xl rounded-b-xl";
        } else if (givenPosition === "end") {
            validRounded = "rounded-t-xl rounded-b-3xl";
        } else if (givenPosition === "center") {
            validRounded = "rounded-xl";
        }
    }
}
validRounded += " hover:rounded-3xl transition-all duration-200 ease-in-out";

// Base look = deactive state. This is always applied on the element.
const baseClass = `${validRounded} filter-btn group relative flex flex-row items-center justify-start min-w-fit w-full h-fit gap-2 p-4 bg-L_Secondary dark:bg-D_Secondary hover:bg-Highlight text-nowrap font-semibold text-left text-[min(6vw,1rem)] text-LT_Primary dark:text-DT_Primary hover:text-LT_Inverted dark:hover:text-DT_Inverted overflow-hidden cursor-pointer capitalize`;

// Active-state overrides only (uses `!` so they win over baseClass
// regardless of stylesheet order — same pattern as the icon-radio button).
const activeOverrideClass =
    "bg-Accent! hover:bg-Highlight! text-LT_Inverted! dark:text-DT_Inverted! uppercase! capitalize-none!";

const isSVG = givenSymbol ? "inline" : "hidden";
---

<button
    type="button"
    id={givenID}
    class={baseClass}
    data-radgroup={groupName}
    data-radstate={givenState ? "true" : "false"}
    data-radActive={activeOverrideClass}
    data-candisabled={canDisabled ? "true" : "false"}
    data-lang={dataLang}
>
    <div
        class="flex flex-row items-center justify-center w-fit h-fit rounded-3xl p-2 bg-L_Primary dark:bg-D_Primary group-hover:bg-L_Primary_Hover dark:group-hover:bg-D_Primary_Hover text-LT_Secondary dark:text-DT_Secondary"
        data-radActive="bg-LightAccent!"
    >
        <GoogleMaterialSymbol
            symbol={givenSymbol}
            SvgSize="text-[min(6vw,1.5rem)]"
            isFilled={true}
        />
    </div>
    <p id="title">
        {givenTitle}
    </p>
</button>
