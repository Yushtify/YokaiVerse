---
import Vertical from "../../seperators/vertical.astro";
import Button from "../buttons/Button.astro";
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";
---

<!-- Controls -->
<div
  id="video_TopInformation"
  class="absolute top-0 flex flex-row items-center justify-start w-full h-fit p-2 gap-4 text-[min(7vw,1rem)] text-LT_Primary dark:text-L_Primary opacity-0 hover:opacity-100 transition-opacity duration-300 ease-in-out z-2 overflow-hidden"
>
  <div
    class="flex flex-row items-center justify-start gap-2 min-w-fit h-fit p-2 rounded-full bg-L_Secondary/64 dark:bg-D_Secondary/64 backdrop-blur-3xl overflow-hidden"
  >
    <Button
      givenButtonID="previousEpisode_Button"
      givenButtonTransparency={true}
      givenButtonAction="PreviousEpisode()"
      givenButtonSVG="chevron_left"
      givenButtonSVGSize="!text-[min(7vw,1rem)]"
      givenButtonSVGFill={true}
      tooltipTitleTrans="tooltip.videoPlayer.topInfo.prevEp_Button.header"
      tooltipDescTrans="tooltip.videoPlayer.topInfo.prevEp_Button.desc"
    />
    <Button
      givenButtonID="nextEpisode_Button"
      givenButtonTransparency={true}
      givenButtonAction="NextEpisode()"
      givenButtonSVG="chevron_right"
      givenButtonSVGSize="!text-[min(7vw,1rem)]"
      givenButtonSVGFill={true}
      tooltipTitleTrans="tooltip.videoPlayer.topInfo.nextEp_Button.header"
      tooltipDescTrans="tooltip.videoPlayer.topInfo.nextEp_Button.desc"
    />
  </div>
  <div
    class="flex flex-row items-center justify-center gap-2 w-fit h-fit p-2 rounded-full bg-L_Secondary/64 dark:bg-D_Secondary/64 text-nowrap backdrop-blur-3xl overflow-hidden"
  >
    <p
      id="videoTitle"
      class="w-full rounded-full p-1 px-4 hover:bg-Accent font-normal hover:font-semibold text-[min(7vw,0.8rem)] text-left transition-colors duration-250 ease-in-out capitalize"
    >
      Untitled Anime
    </p>
  </div>
</div>
