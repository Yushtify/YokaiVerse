---
import Horizontal from "../seperators/horizontal.astro";
import GoogleMaterialSymbol from "./googleMaterial_Symbol.astro";

// FilterRounded.astro
interface Props {
  givenGoogleSymbol: string;
  givenTitle: string;
  givenDesc: string;
  titleData: string;
  descData: string;
}

const { givenGoogleSymbol, givenTitle, givenDesc, titleData, descData } =
  Astro.props;
---

<div
  class="relative flex flex-col items-start justify-center gap-2 lg:gap-4 w-full h-fit text-LT_Primary dark:text-DT_Primary text-[min(4vw,1rem)]"
>
  <div class="flex flex-col h-fit w-fit gap-2">
    <div
      class="relative flex flex-row items-center justify-start w-full h-fit gap-4 text-left text-[min(3vw,0.7rem)] font-semibold capitalize"
    >
      <div
        class="flex flex-row p-4 rounded-full bg-L_Tertiary dark:bg-D_Tertiary border border-LB_Secondary/50 dark:border-DB_Secondary/50"
      >
        <GoogleMaterialSymbol
          SVG_Name={givenGoogleSymbol}
          SVG_Style="text-LT_Secondary dark:text-DT_Secondary"
          SvgSize="!text-[min(7vw,2rem)]"
          isFilled={true}
        />
      </div>
      <p data-i18n={titleData} class="text-[min(6vw,2.5rem)]">{givenTitle}</p>
    </div>
    <p
      data-i18n={descData}
      class="text-LT_Secondary dark:text-DT_Secondary mt-2 w-full"
    >
      {givenDesc}
    </p>
  </div>

  <slot />

  <Horizontal />
</div>
