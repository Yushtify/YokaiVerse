---
interface Props {
  SVG_ID?: string;
  SVG_Name?: string;
  SVG_Style?: string;
  isFilled?: boolean;
  SvgSize?: string;
}
const { SVG_ID, SVG_Name, SVG_Style, isFilled, SvgSize } = Astro.props;

const isActive = SVG_Name ? "inline" : "!hidden";
const ValidSVG_Style = SVG_Style ? SVG_Style : "";
const ValidIsFilled = isFilled ? "icon-fill" : "";
const ValidSize = SvgSize ? SvgSize : "!text-[min(7vw,1rem)]";
const ValidID = SVG_ID ? SVG_ID : "googleSymbol";
---

<span
  translate="no"
  id={ValidID}
  class={`material-symbols-rounded group-hover:icon-fill ${SVG_Style} ${ValidIsFilled} ${ValidSize} ${isActive}`}
>
  {SVG_Name}
</span>
