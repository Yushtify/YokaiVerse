---
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";

interface Props {
    givenLocationFrom?: "horizontal" | "vertical";
    givenLocation?: "start" | "center" | "end";
    givenButtonID: string;
    givenButtonCustomClass?: string;
    givenButtonTransparency?: boolean;
    givenButtonFill?: boolean;
    givenButtonAction: string;
    givenButtonSymbol?: string;
    givenButtonSymbolSize?: string;
    givenButtonSymbolFill?: boolean;
    givenTitle?: string;
    titleData?: string;
    tooltipTitle?: string;
    tooltipDesc?: string;
    tooltipTitleTrans?: string;
    tooltipDescTrans?: string;
}

const {
    givenLocationFrom,
    givenLocation,

    givenButtonID,
    givenButtonCustomClass,
    givenButtonTransparency,
    givenButtonFill,
    givenButtonAction,
    givenButtonSymbol,
    givenButtonSymbolSize,
    givenButtonSymbolFill,

    givenTitle,
    titleData,

    tooltipTitle,
    tooltipTitleTrans,
    tooltipDesc,
    tooltipDescTrans,
} = Astro.props;

let borderRadius;
if (givenLocationFrom && givenLocation) {
    // checks if this companent got any of the attributes
    if (givenLocationFrom === "horizontal") {
        // if the buttons aligned left to right so horizontally
        if (givenLocation === "start") {
            borderRadius = "rounded-xl rounded-l-3xl";
        } else if (givenLocation === "end") {
            borderRadius = "rounded-xl rounded-r-3xl";
        } else {
            borderRadius = "rounded-xl";
        }
    } else if (givenLocationFrom === "vertical") {
        // if the buttons aligned top to bottom so vertically
        if (givenLocation === "start") {
            borderRadius = "rounded-xl rounded-t-3xl";
        } else if (givenLocation === "end") {
            borderRadius = "rounded-xl rounded-b-3xl";
        } else {
            borderRadius = "rounded-xl";
        }
    }
} else {
    borderRadius = "rounded-3xl";
}
let validBorder = " " + borderRadius + " hover:rounded-3xl";

const isWFill = givenButtonFill ? " w-full min-w-fit " : " min-w-fit w-fit ";
const transparentBG = `group flex flex-row items-center justify-center px-4 p-2 gap-2 h-fit hover:bg-Accent hover:font-semibold text-[min(7vw,1rem)] text-LT_Primary dark:text-DT_Primary hover:text-LT_Inverted dark:hover:text-DT_Inverted transition-all duration-200 ease-in-out cursor-pointer ${isWFill} ${validBorder}`;
const BG = `group flex flex-row items-center justify-center px-4 p-2 gap-2 h-fit rounded-full bg-L_Secondary dark:bg-D_Secondary hover:bg-Accent hover:font-semibold text-[min(7vw,1rem)] text-LT_Primary dark:text-DT_Primary hover:text-LT_Inverted dark:hover:text-DT_Inverted transition-all duration-200 ease-in-out cursor-pointer ${isWFill} ${validBorder}`;

const ButtonClass = givenButtonTransparency
    ? transparentBG + " " + givenButtonCustomClass
    : BG + " " + givenButtonCustomClass;

const ValidSvgSize = givenButtonSymbolSize
    ? givenButtonSymbolSize
    : "text-[min(7vw,1rem)]!";

const isTitleValid = givenTitle ? "flex" : "hidden";
---

<button
    id={givenButtonID}
    class={ButtonClass}
    onclick={givenButtonAction}
    data-tooltip={tooltipDesc}
    data-tooltip-title={tooltipTitle}
    data-tooltip-desc-trans={tooltipDescTrans}
    data-tooltip-title-trans={tooltipTitleTrans}
>
    <GoogleMaterialSymbol
        symbol={givenButtonSymbol}
        SvgSize={ValidSvgSize}
        isFilled={givenButtonSymbolFill}
    />
    <p data-i18n={titleData} class={` ${isTitleValid}`}>{givenTitle}</p>
</button>
