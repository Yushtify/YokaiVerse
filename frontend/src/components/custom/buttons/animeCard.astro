---
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";
import Button from "./Button.astro";

interface Props {
  givenVideoID: string;
  VideoRootSRC: string;
  givenVideoTitle: string;
  givenVideoUploader: string;
  givenNSFW: boolean;
}

const {
  givenVideoID,
  VideoRootSRC,
  givenVideoTitle,
  givenVideoUploader,
  givenNSFW,
} = Astro.props;
const CoverIMG = VideoRootSRC + "/cover.webp";
const activeNSFW = givenNSFW ? "flex" : "hidden";
---

<template id="animeCardTemplate">
  <div
    class="group relative flex flex-col items-start justify-start snap-start w-full h-fit rounded-3xl gap-4 xl:gap-4"
  >
    <!-- Cover -->
    <button
      id="coverButton"
      class="relative flex flex-col rounded-3xl aspect-2/3 w-full h-auto cursor-pointer overflow-hidden group-hover:-translate-y-2 gorup-hover:scale-102 shadow-2xl shadow-transparent group-hover:shadow-LB_Primary/56 group-hover:dark:shadow-DB_Primary/56 transition-transform duration-250 ease-in-out"
      onclick={`findAnimeInfo('${givenVideoID}')`}
    >
      <img
        id="animeCover"
        src={CoverIMG}
        alt="COVER"
        class="rounded-3xl aspect-9/16 w-full h-full border-2 border-LB_Primary dark:border-DB_Primary"
      />

      <div
        class="absolute bottom-0 left-0 flex flex-col items-start justify-end p-4 gap-2 w-full h-[45%] group-hover:h-[70%] bg-gradient-to-t from-LB_Primary dark:from-DB_Primary to-transparent transition-normal duration-250 ease-in-out"
      >
        <p
          id="animeUploadedBy"
          class="text-[min(6vw,0.8rem)] line-clamp-1 group-hover:opacity-100 opacity-0 transition-opacity duration-250 ease-in-out"
        >
          By @<span id="animeUploadedBy_Text">{givenVideoUploader}</span>
        </p>
        <p
          id="animeTitle"
          class="w-full h-fit text-left font-bold text-[min(7vw,1.2rem)] capitalize line-clamp-1 group-hover:line-clamp-4"
        >
          {givenVideoTitle}
        </p>
      </div>

      <!-- NSFW Filter -->
      <div
        id="animeCardNsfwFilter"
        class={`${activeNSFW} absolute flex-col items-center justify-center gap-2 p-8 aspect-2/3 w-full h-full rounded-3xl text-[min(7vw,0.9rem)] bg-L_Secondary dark:bg-D_Secondary border-2 border-LB_Primary dark:border-DB_Primary`}
      >
        <div
          class="flex flex-row items-center justify-center gap-2 rounded-3xl w-fit h-fit p-4 bg-L_Tertiary dark:bg-D_Tertiary border-2 border-Accent font-bold text-Accent"
        >
          <GoogleMaterialSymbol
            SVG_Name="18_up_rating"
            SvgSize="!text-[min(7vw,2rem)] text-Accent"
            isFilled={true}
          />
          <p class="text-[min(7vw,1.4rem)]">NSFW</p>
        </div>
        <p class="text-LT_Secondary dark:text-DT_Secondary">
          This content is marked as NSFW.
        </p>
      </div>
    </button>
    <div class="flex flex-col items-start justify-start w-full h-fit text-left">
      <Button
        givenButtonID="playButton"
        givenButtonTransparency={false}
        givenButtonFill={true}
        givenButtonAction={`findAnime('${givenVideoID}')`}
        givenButtonSVG="play_arrow"
        givenButtonSVGSize="!text-[min(7vw,1.5rem)]"
        givenButtonSVGFill={true}
      />
    </div>
  </div>
</template>
