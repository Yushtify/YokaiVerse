---
import Button from "../../custom/buttons/customRadioButton.astro";
---

<div
  class="flex flex-col items-center justify-start rounded-3xl p-4 gap-2 w-full h-fit border border-LB_Primary dark:border-DB_Primary overflow-hidden"
>
  <div class="flex flex-row items-center justify-start gap-4 px-2 h-fit w-full">
    <p
      data-i18n="watch.fansubSection.title"
      class="flex h-fit w-fit text-[min(6vw,1.2rem)] text-nowrap text-LT_Primary dark:text-DT_Primary capitalize font-semibold"
    >
      Choose a Language:
    </p>
    <p
      id="activeFansubDisplay"
      data-i18n="watch.fansubSection.none"
      class="flex h-fit w-fit text-[min(6vw,0.95rem)] text-nowrap text-LT_Secondary dark:text-DT_Secondary capitalize font-semibold"
    >
      None
    </p>
  </div>

  <!-- Lang Radio -->
  <div
    class="flex max-sm:flex-col sm:flex-row items-start justify-start gap-2 h-fit w-full overflow-x-scroll overflow-y-hidden"
  >
    <Button
      givenTitle="English - EN"
      givenState={true}
      givenID="a"
      groupName="fansubSelection"
    />
    <Button
      givenTitle="Turkish - TR"
      givenState={false}
      givenID="a"
      groupName="fansubSelection"
    />
  </div>
</div>
