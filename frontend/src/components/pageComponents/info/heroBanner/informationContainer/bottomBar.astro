---
import InformationBlobs from "../../../../custom/public/informationBlobs.astro";
---

<div
  class="relative flex flex-col xl:flex-row items-start justify-end w-full h-fit dark:to-transparent z-2"
>
  <p
    id="contentTitle"
    class="w-full h-fit font-bold text-[min(7vw,3.4rem)] capitalize"
  >
    content title
  </p>
  <div class="hidden lg:flex flex-row items-end justify-end gap-4 w-full h-fit">
    <InformationBlobs
      givenID="contentDuration_Banner"
      givenTextID="contentDuration_BannerText"
      givenTitle="duration"
      titleData="info.banner.bottomBar.contentDuration.title"
      givenSVG="timer"
      givenInformation="Loading Data..."
      informationData=""
    />
    <InformationBlobs
      givenID="contentRating_Banner"
      givenTextID="contentRating_BannerText"
      givenTitle="content rating"
      titleData="info.banner.bottomBar.contentRating.title"
      givenSVG="shield_question"
      givenInformation="Loading Data..."
      informationData=""
    />
    <InformationBlobs
      givenID="releaseDate_Banner"
      givenTextID="releaseDate_BannerText"
      givenTitle="release date"
      titleData="info.banner.bottomBar.contentRelease.title"
      givenSVG="date_range"
      givenInformation="Loading Data..."
      informationData=""
    />
  </div>
</div>
