---
import InformationContainer from "./informationContainer/informationContainer.astro";
---

<div
  class="relative flex flex-col items-center justify-start w-full h-auto min-h-75 lg:aspect-21/9 bg-L_Secondary dark:bg-D_Secondary text-[min(7vw,1rem)] text-LT_Primary dark:text-DT_Primary overflow-hidden shrink-0"
>
  <img
    id="BannerImage"
    class="absolute inset-0 w-full h-full object-cover z-0"
    src=""
    alt="BANNER"
  />

  <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent z-1">
  </div>

  <div class="relative z-10 w-full h-full">
    <InformationContainer />
  </div>
</div>
