---
import RadioButton from "../../custom/buttons/customRadioButton.astro";
import GoogleMaterialSymbol from "../../custom/googleMaterial_Symbol.astro";
import HeroTemplate from "../../custom/heroTemplate.astro";

import SearchBar from "../../custom/searchBar.astro";
---

<HeroTemplate
  givenTitle="featured [BETA]"
  titleData="featured.hero.header"
  givenDesc="Browse and featured anime titles. Find something new to watch, or revisit your favorites."
  descData="featured.hero.desc"
  givenGoogleSymbol="star"
>
  <div
    class="relative flex flex-col items-start justify-center gap-4 w-full h-fit text-left text-[min(4vw,1rem)] text-LT_Primary dark:text-DT_Primary"
  >
    <div
      class="relative flex flex-col items-start justify-center gap-4 w-full h-fit text-left text-[min(4vw,1rem)] text-LT_Primary dark:text-DT_Primary"
    >
      <div
        class="flex flex-row flex-wrap w-full h-fit items-center justify-start gap-4"
      >
        <!-- Searchbar and quick tags -->

        <div
          class="relative flex flex-row items-center justify-start gap-2 rounded-3xl p-2 w-fit h-fit border border-LB_Primary dark:border-DB_Primary"
        >
          <RadioButton
            givenTitle="Top Anime"
            givenID="topAnimeFilter"
            titleData="featured.hero.filters.topAnime"
            groupName="mediaTypeFilter"
            givenState={true}
            givenSVG="comic_bubble"
            givenSVGSize="!text-[min(7vw,1.5rem)]"
            givenSVGFill={true}
          />
          <RadioButton
            givenTitle="Top Manga"
            givenID="topMangaFilter"
            titleData="featured.hero.filters.topManga"
            groupName="mediaTypeFilter"
            givenState={false}
            givenSVG="manga"
            givenSVGSize="!text-[min(7vw,1.5rem)]"
          />
          <RadioButton
            givenTitle="Top Webtoon"
            givenID="topWebtoonFilter"
            titleData="featured.hero.filters.topWebtoon"
            groupName="mediaTypeFilter"
            givenState={false}
            givenSVG="web"
            givenSVGSize="!text-[min(7vw,1.5rem)]"
          />
        </div>
        <div
          class="relative flex flex-row items-center justify-start gap-2 rounded-3xl p-2 w-fit h-fit border border-LB_Primary dark:border-DB_Primary"
        >
          <RadioButton
            givenTitle="SFW"
            givenID="sfwFilter"
            titleData="featured.hero.filters.sfw"
            groupName="nsfwToggle"
            givenState={true}
            givenSVG="shield"
            givenSVGSize="!text-[min(7vw,1.5rem)]"
            givenSVGFill={true}
          />
          <RadioButton
            givenTitle="NSFW"
            givenID="nsfwFilter"
            titleData="featured.hero.filters.nsfw"
            groupName="nsfwToggle"
            givenState={false}
            givenSVG="18_up_rating"
            givenSVGSize="!text-[min(7vw,1.5rem)]"
          />
        </div>

        <!-- Search bar -->
        <SearchBar
          givenID="featuredSearch"
          givenClass="w-full h-fit outline-0"
          givenPlaceHolder="Type or Press CTRL + K to search"
          data="featured.hero.searchPlaceholder"
        />
      </div>
    </div>
  </div>
</HeroTemplate>
