---
import Layout from "../../pageContent_Wrappers/default.astro";
import Lister from "../public/lister.astro";
import Hero from "./hero.astro";
---

<Layout>
  <Hero />

  <!-- Category listers are injected here by lister.astro's script -->
  <div
    id="featuredListComp"
    class="flex flex-col items-start justify-start gap-16 w-full h-full"
  >
  </div>

  <!-- Lister template — not visible, used by the script above -->
  <Lister givenSVG="star" givenTitle="Featured" />
</Layout>
