---
import AnimeCard from "../../custom/buttons/animeCard.astro";
import Lister from "../public/lister.astro";
---

<Lister givenSVG="" givenTitle="Movies" givenDesc="Da thing I do for ya'.">
  <AnimeCard
    givenVideoID="murderDrones"
    VideoRootSRC="/src/assets/animes/murderDrones"
    givenVideoTitle="murder drones"
    givenVideoUploader="Glitch"
    givenNSFW={false}
  />
</Lister>

<script>
  function formatTime(duration: number): string {
    if (!duration || isNaN(duration)) return "0:00";
    const h = Math.floor(duration / 3600);
    const m = Math.floor((duration % 3600) / 60);
    const s = Math.floor(duration % 60)
      .toString()
      .padStart(2, "0");
    return h > 0 ? `${h}:${m.toString().padStart(2, "0")}:${s}` : `${m}:${s}`;
  }

  async function updateVideoDurations(): Promise<void> {
    const labels = document.querySelectorAll<HTMLElement>("#videoDuration");

    labels.forEach(async (label) => {
      const root = label.getAttribute("data-videoRootSRC");
      if (!root) return;

      try {
        // get the type in the video, from json
        const res = await fetch(`${root}/information.json`);
        if (!res.ok) throw new Error("could not find JSON");

        const data = await res.json();
        const videoType = data.type; // ".mp4" or ".webm" or anything, but has to come with dot.

        if (!videoType) {
          console.error(
            `[ERROR] JSON is valid but'type' value doesn't exist or has typo: ${root}`,
          );
          return;
        }

        // 2. JSON'dan aldığımız uzantı ile gerçek video yolunu kuruyoruz
        const videoPath = `${root}/video${videoType}`;
        const v = document.createElement("video");
        v.preload = "metadata";
        v.src = videoPath;

        // Metadata yüklendiğinde süreyi yaz
        v.onloadedmetadata = () => {
          const icon = label.querySelector("#googleIcon")?.outerHTML || "";
          label.innerHTML = `${icon} ${formatTime(v.duration)}`;
          label.classList.remove("hidden");

          // Temizlik: Tarayıcı şişmesin
          v.src = "";
          v.load();
          v.remove();
        };
      } catch (e) {
        console.error(
          `[JSON ERROR] ${root}/information.json. unable to locate`,
        );
      }
    });
  }

  document.addEventListener("DOMContentLoaded", updateVideoDurations);
</script>
