---
import AnimeCard from "../../custom/buttons/animeCard.astro";
import Button from "../../custom/buttons/Button.astro";
import GoogleMaterialSymbol from "../../custom/googleMaterial_Symbol.astro";
interface Props {
  givenSVG?: string;
  givenTitle: string;
  titleData: string;
  givenDesc?: string;
  descData?: string;
}
const { givenSVG, givenTitle, titleData, givenDesc, descData } = Astro.props;
const isDescValid = givenDesc ? "flex" : "hidden";
---

<div
  id="Lister"
  class="flex flex-col items-start justify-center gap-8 w-full h-fit text-[min(5vw,1rem)] text-LT_Primary dark:text-DT_Primary"
>
  <div class="flex flex-row items-center justify-start w-full h-fit gap-4">
    <div class="flex flex-col w-full h-fit items-start justify-center">
      <div class="flex flex-row items-center justify-start gap-2 w-full h-fit">
        <GoogleMaterialSymbol
          SVG_ID="listerSVG"
          SVG_Name={givenSVG}
          isFilled={true}
          SvgSize="!text-[min(6vw,2rem)]"
        />
        <p
          id="listerTitle"
          data-i18n={titleData}
          class="font-bold text-[min(6vw,2rem)] capitalize text-nowrap"
        >
          {givenTitle}
        </p>
      </div>
      <p
        id="listerDesc"
        data-i18n={descData}
        class={`w-full lg:max-w-[80%] xl:max-w-[65%] text-LT_Secondary dark:text-DT_Secondary ${isDescValid}`}
      >
        {givenDesc}
      </p>
    </div>

    <div
      id="seasonSwitch"
      class="flex flex-row items-center justify-center gap-4 p-2 rounded-3xl w-fit h-fit border border-LB_Primary dark:border-DB_Primary"
    >
      <Button
        givenButtonID="nextPage"
        givenButtonAction=""
        givenButtonSVG="chevron_backward"
        givenButtonSVGSize="text-[min(7vw,1rem)]"
      />
      <Button
        givenButtonID="previousPage"
        givenButtonAction=""
        givenButtonSVG="chevron_forward"
        givenButtonSVGSize="text-[min(7vw,1rem)]"
      />
    </div>
  </div>

  <!-- Grid -->
  <div
    id="animeCardLister"
    class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 items-start justify-start gap-4 w-full h-fit"
  >
    <AnimeCard
      givenVideoID="Template"
      VideoRootSRC="/src/assets/animes/murderDrones"
      givenVideoTitle="Template"
      givenVideoUploader="Template"
      givenNSFW={false}
    />
    <slot />
  </div>
</div>
