---
import TitleBar from "./titleBar.astro";
import ControlBar from "./controlBar.astro";
---

<div
    onfocus=""
    id="epPlayerContainer"
    class="relative flex flex-col items-start justify-start rounded-3xl w-full h-full aspect-video bg-L_Tertiary dark:bg-D_Tertiary border-LB_Secondary dark:border-DB_Secondary cursor-default z-1 select-none"
>
    <canvas
        id="epCinemaLights"
        class="absolute inset-0 w-full h-full blur-[60px] opacity-100 pointer-events-none transition-opacity duration-500 ease-in-out z-0"
    ></canvas>
    <video
        id="episodePlayer"
        class="absolute top-0 left-0 flex rounded-3xl w-full h-full aspect-video"
    >
    </video>
    <div
        id="epControlContainer"
        class="absolute top-0 flex flex-col items-start justify-between gap-4 p-2 md:p-4 w-full h-full"
    >
        <TitleBar />
        <ControlBar />
    </div>
</div>

<script>
    import "./playerControls"; // Controls for the Player.
    import "./playerKeybinds"; // Keyboard Keybinds For Player.
    import "./playerGesturesAndMouse"; // Controls mouse gestures for the Player.
</script>
