---
import NavigationBar from "../components/navigationBar.astro";
import SideBar from "../components/sideBar.astro";

import Body from "./body.astro";

interface Props {
  givenSideBarTitle: string;
  givenSideBarDesc: string;
}

const { givenSideBarTitle, givenSideBarDesc } = Astro.props;
---

<Body>
  <div
    class="relative flex flex-col gap-2 w-full min-h-screen p-2 overflow-hidden"
  >
    <!-- Navigation Bar -->
    <NavigationBar />
    <!-- Main Contents -->
    <div
      class="relative flex w-full h-full items-center justify-center overflow-hidden"
    >
      <div
        class="relative flex flex-col items-center jusitfy-start w-full h-full rounded-3xl bg-L_Primary dark:bg-D_Primary border border-LB_Primary dark:border-DB_Primary overflow-hidden"
      >
        <div
          class="relative flex flex-col items-center jusitfy-start w-full h-full p-4 md:p-8 overflow-hidden overflow-y-scroll"
        >
          <div
            class="flex flex-row items-start justify-start gap-8 w-full h-full"
          >
            <SideBar
              givenTitle={givenSideBarTitle}
              givenDesc={givenSideBarDesc}
            />
            <slot />
          </div>
        </div>
      </div>
    </div>
  </div>
</Body>
