---
// Script For Title.
const { pathname } = Astro.url;

const routes: Record<string, string> = {
    "/": "Home",
    "/featured": "Featured [BETA]",
    "/discover": "Discover",
    "/changelog": "Release Logs",
    "/roadmap": "Road Map",
    "/store": "Store",
    "/settings": "Settings",
    "/info/anime": "Anime Information",
    "/info/manga": "Manga Information",
    "/watch": "Watching",
    "/read": "Reading",
    "/doc": "Documentation",
    "/doc/terms": "Terms Of Service",
    "/doc/privacy": "Privacy Policy",
};

const title = "YokaiVerse | " + (routes[pathname] ?? "404: Not Found");

import "../styles/global.css";

import Footer from "../components/footer.astro";
import LoadingAnimation from "../components/custom/loadingAnimation.astro";
import SearchBox from "../components/custom/searchBox/container.astro";
import Tooltip from "../components/custom/public/tooltip.astro";

import NavigationBar from "../components/navigationBar.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>{title}</title>
        <link rel="icon" href="/favicon.svg" type="image/png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
        />
    </head>
    <body
        class="relative bg-L_BG dark:bg-D_BG font-Sans caret-Accent accent-Accent selection:text-Accent selection:bg-Accent/10 overflow-x-hidden select-text scroll-smooth custom-scrollbar"
    >
        <Tooltip />
        <SearchBox />
        <LoadingAnimation />
        <!-- Navigation Bar -->
        <NavigationBar />
        <slot />
        <Footer />
    </body>
</html>

<script>
    import "../scripts/radioButtonHandler.ts"; // Radio Button Handler
    import "../scripts/dropdownHandler.ts"; // Dropdown Handler
    import "../scripts/languageHandler.ts"; // Language Handler
    import "../scripts/tooltipHandler.ts"; // Tooltip Handler
    import "../scripts/svgScripts.ts";
    import "../components/pageComponents/settings/scripts/themeHandler.ts"; // Theme handler script
    import "../scripts/seriesRedirects.ts"; // Series Redirects
    import "../components/pageComponents/settings/scripts/settingsControls.ts"; // This is included so the settings do load
</script>

<script>
    (function () {
        let theme = "system";
        try {
            const raw = localStorage.getItem("yokaiverseSettings");
            if (raw) {
                const parsed = JSON.parse(raw);
                if (parsed && typeof parsed.theme === "string")
                    theme = parsed.theme;
            }
        } catch (_) {}
        const isDark =
            theme === "dark" ||
            (theme === "system" &&
                window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", isDark);
    })();
</script>
