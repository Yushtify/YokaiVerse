---
import SideNavigationBar from "../components/sideNavigationBar.astro";
import NavigationBar from "../components/navigationBar.astro";

import Body from "./body.astro";
import VideoPlayer from "../components/custom/videoPlayer/customVideoPlayer.astro";
---

<Body>
  <div class="flex flex-row items-start jusitfy-center">
    <!-- SideBar -->
    <SideNavigationBar />

    <div
      class="relative flex flex-col w-full h-screen gap-2 p-2 overflow-hidden"
    >
      <!-- Navigation Bar -->
      <NavigationBar />
      <!-- Main Contents -->
      <div
        class="relative flex w-full h-full items-center justify-center overflow-hidden"
      >
        <div
          class="relative flex flex-col items-center jusitfy-start w-full h-full rounded-xl bg-Light_Primary dark:bg-Dark_Primary border border-Light_Border_Primary dark:border-Dark_Border_Primary overflow-hidden"
        >
          <div
            id="mainContent"
            class="relative flex flex-col items-center jusitfy-start w-full h-full pt-8 p-4 overflow-hidden overflow-y-scroll"
          >
            <slot />
          </div>
          <!-- <VideoPlayer /> -->
        </div>
      </div>
    </div>
  </div>
</Body>
