---
import NavigationBar from "../components/navigationBar.astro";

import Body from "./body.astro";
---

<Body>
  <div
    class="relative md:flex-col flex flex-col-reverse gap-2 w-full h-screen p-2 overflow-hidden"
  >
    <!-- Navigation Bar -->
    <NavigationBar />
    <!-- Main Contents -->
    <div
      class="relative flex w-full h-full items-center justify-center overflow-hidden"
    >
      <div
        class="relative flex flex-col items-center jusitfy-start w-full h-full rounded-xl bg-Light_Primary dark:bg-Dark_Primary border border-Light_Border_Primary dark:border-Dark_Border_Primary overflow-hidden"
      >
        <div
          class="relative flex flex-col items-center jusitfy-start w-full h-full p-4 md:p-8 overflow-hidden overflow-y-scroll"
        >
          <slot />
        </div>
      </div>
    </div>
  </div>
</Body>
