---
import Layout from "../layouts/default.astro";

import WhatsNewCompanents from "../components/pageComponents/whats-new/whatsNewCompanents.astro";
---

<Layout>
  <WhatsNewCompanents />
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    handleNewFeatures();
    handleFixedFeatures();
    handleChangedFeatures();
    handleoptimizedFeatures();
    handleRemovedFeatures();
    handleNotesFeatures();
  });

  const ElementID_s = {
    FixedFeature: "#fixedFeature",
    NewFeature: "#newFeature",
    ChangedFeature: "#changedFeature",
    optimizedFeature: "#optimizedFeature",
    RemovedFeature: "#removedFeature",
    UpdateNote: "#updateNote",
  };

  const texts = ["fixed", "added", "changed", "optimized", "removed", "note"];

  function handleNewFeatures() {
    // Aynı class'a sahip tüm elementleri seç
    const elements = document.querySelectorAll(ElementID_s.NewFeature);

    elements.forEach((element) => {
      const previousText = element.innerHTML;
      if (!previousText) return;

      const addedTag =
        '<span class="textBold addedTag header">' + texts[1] + "</span>";
      element.innerHTML = addedTag + previousText;
    });
  }
  function handleFixedFeatures() {
    // Aynı class'a sahip tüm elementleri seç
    const elements = document.querySelectorAll(ElementID_s.FixedFeature);

    elements.forEach((element) => {
      const previousText = element.innerHTML;
      if (!previousText) return;

      const fixedTag =
        '<span class="textBold fixedTag header">' + texts[0] + "</span>";
      element.innerHTML = fixedTag + previousText;
    });
  }
  function handleChangedFeatures() {
    // Aynı class'a sahip tüm elementleri seç
    const elements = document.querySelectorAll(ElementID_s.ChangedFeature);

    elements.forEach((element) => {
      const previousText = element.innerHTML;
      if (!previousText) return;

      const changedTag =
        '<span class="textBold changedTag header">' + texts[2] + "</span>";
      element.innerHTML = changedTag + previousText;
    });
  }
  function handleoptimizedFeatures() {
    // Aynı class'a sahip tüm elementleri seç
    const elements = document.querySelectorAll(ElementID_s.optimizedFeature);

    elements.forEach((element) => {
      const previousText = element.innerHTML;
      if (!previousText) return;

      const optimizedTag =
        '<span class="textBold optimizedTag header">' + texts[3] + "</span>";
      element.innerHTML = optimizedTag + previousText;
    });
  }
  function handleRemovedFeatures() {
    // Aynı class'a sahip tüm elementleri seç
    const elements = document.querySelectorAll(ElementID_s.RemovedFeature);

    elements.forEach((element) => {
      const previousText = element.innerHTML;
      if (!previousText) return;

      const removedTag =
        '<span class="textBold removedTag header">' + texts[4] + "</span>";
      element.innerHTML = removedTag + previousText;
    });
  }
  function handleNotesFeatures() {
    // Aynı class'a sahip tüm elementleri seç
    const elements = document.querySelectorAll(ElementID_s.UpdateNote);

    elements.forEach((element) => {
      const previousText = element.innerHTML;
      if (!previousText) return;

      const notesTag =
        '<span class="textBold updateNoteTag header">' + texts[5] + "</span>";
      element.innerHTML = notesTag + previousText;
    });
  }

  function dropdownClick(button: HTMLButtonElement) {
    if (!button) return console.warn("Button returned undefined.");
    let buttonID = button.id as string;
    if (!buttonID) return console.warn("Couldn't find the id of the button");

    let updateLogWrapperID = "features_" + buttonID;

    let updateLogWrapper = document.getElementById(
      updateLogWrapperID
    ) as HTMLDivElement;
    if (!updateLogWrapper)
      return console.warn("UpdateLogWrapper returned undefined");

    if (updateLogWrapper.classList.contains("nonVisible")) {
      expandTheUpdate(updateLogWrapper);
      buttonArrowSwitch(false, button);
    } else {
      collapseTheUpdate(updateLogWrapper);
      buttonArrowSwitch(true, button);
    }
  }
  (window as any).dropdownClick = dropdownClick;

  function buttonArrowSwitch(arrowUp: boolean, button: HTMLButtonElement) {
    if (arrowUp) {
      let ArrowIcon = button.querySelector(".fa-chevron-down");
      ArrowIcon?.classList.add("fa-chevron-up");
      ArrowIcon?.classList.remove("fa-chevron-down");
    } else {
      let ArrowIcon = button.querySelector(".fa-chevron-up");
      ArrowIcon?.classList.add("fa-chevron-down");
      ArrowIcon?.classList.remove("fa-chevron-up");
    }
  }

  function collapseTheUpdate(div: HTMLDivElement) {
    if (div.classList.contains("Visible")) div.classList.remove("Visible");
    if (!div.classList.contains("nonVisible")) div.classList.add("nonVisible");
  }
  function expandTheUpdate(div: HTMLDivElement) {
    if (!div.classList.contains("Visible")) div.classList.add("Visible");
    if (div.classList.contains("nonVisible"))
      div.classList.remove("nonVisible");
  }
</script>
