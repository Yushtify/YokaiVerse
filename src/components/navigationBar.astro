---
import NavigationLinkButton from "./custom/buttons/navigationHorizontal.astro";
import GoogleMaterialSymbol from "./custom/googleMaterial_Symbol.astro";
import SearchBar from "./custom/searchBar.astro";

const currentPath = Astro.url.pathname;

const InactiveTab_Landing =
  "flex flex-row items-center justify-center w-fit h-full aspect-square gap-2 rounded-xl p-4 hover:font-semibold text-[min(7vw,1rem)] !text-Light_Text_Secondary/64 dark:!text-Dark_Text_Secondary/64 hover:!text-Accent hover:bg-Light_Secondary_Hover dark:hover:bg-Dark_Secondary_Hover border border-transparent transition-colors duration-300 ease-in-out overflow-hidden";
const ActiveTab_Landing =
  "flex flex-row items-center justify-center w-fit h-full aspect-square gap-2 rounded-xl p-4 font-semibold text-[min(vw,1rem)] !text-Accent hover:!text-Accent bg-Light_Primary dark:bg-Dark_Primary hover:bg-Light_Primary_Hover dark:hover:bg-Dark_Primary_Hover border border-Accent transition-colors duration-300 ease-in-out overflow-hidden";

const isActive = (path: string) => currentPath === path;
---

<div
  class="flex flex-row items-center justify-center sm:justify-between gap-4 w-full h-fit"
>
  <!-- Left Elements -->
  <div class="flex flex-row items-center justify-center gap-4 min-w-fit h-fit">
    <a href="/" class={isActive("/") ? ActiveTab_Landing : InactiveTab_Landing}>
      <img src="/logo.svg" alt="YOKAIVERSE LOGO" class="h-5 aspect-square" />
    </a>
    <NavigationLinkButton
      givenSVG="home"
      givenHref="/home"
      givenTitle="home"
      givenData="Navbar.home"
    />
    <NavigationLinkButton
      givenSVG="star"
      givenHref="/featured"
      givenTitle="featured"
      givenData="Navbar.featured"
    />
    <NavigationLinkButton
      givenSVG="explore"
      givenHref="/discover"
      givenTitle="discover"
      givenData="Navbar.discover"
    />
  </div>
  <!-- Middle Elements -->
  <div
    class="hidden md:flex flex-row items-center justify-start gap-4 w-full h-fit"
  >
    <SearchBar
      givenID="globalSearch"
      data="Navbar.search_placeholder"
      givenPlaceHolder="Enter your email to log in"
    />
  </div>
  <div class="flex flex-row items-center justify-center gap-4 min-w-fit h-fit">
    <!-- Right Elements -->
    <NavigationLinkButton
      givenSVG="settings"
      givenHref="/settings"
      givenTitle="Settings"
      givenData="Navbar.settings"
    />
  </div>
</div>
