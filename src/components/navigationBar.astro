---
import NavigationLinkButton from "./custom/buttons/navigationHorizontal.astro";
---

<div
    class="sticky flex top-0 flex-row items-center justify-center p-2 w-screen h-fit z-999"
>
    <div
        class="relative flex flex-row items-center justify-between p-2 rounded-3xl gap-2 w-full h-fit bg-L_Primary/48 dark:bg-D_Primary/48 backdrop-blur-3xl"
    >
        <!-- Left Elements -->
        <div
            class="flex flex-row items-center justify-center gap-2 min-w-fit h-fit"
        >
            <a
                href="/"
                class="flex flex-row items-center justify-center w-fit max-h-full h-full aspect-square gap-2 overflow-hidden"
            >
                <img
                    src="/logo.svg"
                    alt="YOKAIVERSE LOGO"
                    class="h-12 aspect-square dark:hidden"
                />
                <img
                    src="/logo_d.svg"
                    alt="YOKAIVERSE LOGO"
                    class="h-12 aspect-square hidden dark:inline"
                />
            </a>
            <NavigationLinkButton
                givenLocationFrom="horizontal"
                givenLocation="start"
                givenSymbol="home"
                givenHref="/"
                givenTitle="home"
                givenData="Navbar.home"
            />
            <NavigationLinkButton
                givenLocationFrom="horizontal"
                givenLocation="center"
                givenSymbol="star"
                givenHref="/featured"
                givenTitle="featured"
                givenData="Navbar.featured"
            />
            <NavigationLinkButton
                givenLocationFrom="horizontal"
                givenLocation="end"
                givenSymbol="explore"
                givenHref="/discover"
                givenTitle="discover"
                givenData="Navbar.discover"
            />
        </div>
        <!-- Right Elements -->
        <div
            class="flex flex-row items-center justify-center gap-4 min-w-fit h-fit"
        >
            <NavigationLinkButton
                givenSymbol="settings"
                givenTitle="Settings"
                givenData="Navbar.settings"
                givenHref="/settings"
            />
        </div>
    </div>
</div>
