---
import ToggleButton from "../../custom/buttons/toggleButton.astro";
import CustomSlider from "../../custom/customSlider.astro";
---

<div
    class="flex flex-col items-start justify-center gap-4 p-2 rounded-3xl w-full h-fit"
>
    <p
        data-i18n="reader.chReader.settings.appearance.title"
        class="font-semibold text-[min(6vw,0.8rem)] text-LT_Secondary dark:text-DT_Secondary capitalize"
    >
        appearance
    </p>
    <div class="flex flex-row items-center justify-between gap-6 w-full h-fit">
        <p
            data-i18n="reader.chReader.settings.appearance.grayScale.title"
            class="font-semibold text-[min(6vw,0.9rem)] text-nowrap capitalize"
        >
            Gray Scale
        </p>
        <CustomSlider
            givenID="chGrayScaleSlider"
            givenOnInput="grayScaleSlider()"
            givenWidth="w-full min-w-24"
            givenMin="0"
            givenMax="100"
            givenValue="0"
            givenStep="0.5"
        />
    </div>
    <div class="flex flex-row items-center justify-between gap-6 w-full h-fit">
        <p
            data-i18n="reader.chReader.settings.appearance.cinemaLights.title"
            class="font-semibold text-[min(6vw,0.9rem)] text-nowrap capitalize"
        >
            Cinema Lights
        </p>
        <ToggleButton
            givenID="chCinemaLightsToggleButton"
            givenAction="cinemaLightCh"
            givenState={true}
            givenSymbol="cinematic_blur"
            tooltipTitleTrans="tooltip.chReader.controlBar.cinemaLightsButton.title"
            tooltipDescTrans="tooltip.chReader.controlBar.cinemaLightsButton.desc"
        />
    </div>
</div>
