---
import Button from "../custom/buttons/Button.astro";
---

<!-- Controls -->
<div
    class="flex flex-row items-center justify-center gap-2 w-fit h-fit p-2 md:p-4 px-4 md:px-6 rounded-full text-[min(6vw,0.9rem)] text-LT_Primary dark:text-DT_Primary text-nowrap overflow-hidden"
>
    <p
        id="mangaTitle"
        class="w-full rounded-full font-semibold text-left capitalize"
    >
        Untitled Manga
    </p>
    <span> : </span>
    <p
        id="chapterTitle"
        class="w-full rounded-full text-[min(6vw,0.9rem)] text-left capitalize"
    >
        Untitled Chapter
    </p>
</div>
