---
import ToggleButton from "../../custom/buttons/toggleButton.astro";
import CustomSlider from "../../custom/customSlider.astro";
---

<div
    class="flex flex-col items-start justify-center gap-4 p-2 rounded-3xl w-full h-fit"
>
    <p
        data-i18n="watch.epPlayer.settings.behaviour.title"
        class="font-semibold text-[min(6vw,0.8rem)] text-LT_Secondary dark:text-DT_Secondary capitalize"
    >
        Behaviour
    </p>

    <!-- Loop -->
    <div class="flex flex-row items-center justify-between gap-6 w-full h-fit">
        <p
            data-i18n="watch.epPlayer.settings.behaviour.loop.title"
            class="font-semibold text-[min(6vw,1rem)] capitalize"
        >
            Loop
        </p>
        <ToggleButton
            givenButtonID="epLoopToggleButton"
            givenButtonAction="loopEp"
            givenState={false}
            givenTitle="Auto Play"
            givenButtonSymbol="repeat"
            tooltipDescTrans="tooltip.epPlayer.controlBar.loopButton"
        />
    </div>

    <!-- Auto Play -->
    <div class="flex flex-row items-center justify-between gap-6 w-full h-fit">
        <p
            data-i18n="watch.epPlayer.settings.behaviour.autoPlay.title"
            class="font-semibold text-[min(6vw,1rem)] capitalize"
        >
            Auto Play
        </p>
        <ToggleButton
            givenButtonID="epAutoPlayToggleButton"
            givenButtonAction="autoPlayEp"
            givenState={true}
            givenTitle="Auto Play"
            givenButtonSymbol="autopause"
            tooltipTitleTrans="tooltip.epPlayer.controlBar.autoPlayButton.title"
            tooltipDescTrans="tooltip.epPlayer.controlBar.autoPlayButton.desc"
        />
    </div>

    <!-- Gestures -->
    <div class="flex flex-row items-center justify-between gap-6 w-full h-fit">
        <p
            data-i18n="tooltip.epPlayer.controlBar.gesturesButton.title"
            class="font-semibold text-[min(6vw,1rem)] capitalize"
        >
            Gestures
        </p>
        <ToggleButton
            givenButtonID="epGesturesToggleButton"
            givenButtonAction="toggleGesturesEp"
            givenState={true}
            givenTitle="Gestures"
            givenButtonSymbol="pan_tool_alt"
            tooltipTitleTrans="tooltip.epPlayer.controlBar.gesturesButton.title"
            tooltipDescTrans="tooltip.epPlayer.controlBar.gesturesButton.desc"
        />
    </div>

    <!-- Keybinds -->
    <div class="flex flex-row items-center justify-between gap-6 w-full h-fit">
        <p
            data-i18n="tooltip.epPlayer.controlBar.keybindsButton.title"
            class="font-semibold text-[min(6vw,1rem)] capitalize"
        >
            Keybinds
        </p>
        <ToggleButton
            givenButtonID="epKeybindsToggleButton"
            givenButtonAction="toggleKeybindsEp"
            givenState={true}
            givenTitle="Keybinds"
            givenButtonSymbol="action_key"
            tooltipTitleTrans="tooltip.epPlayer.controlBar.keybindsButton.title"
            tooltipDescTrans="tooltip.epPlayer.controlBar.keybindsButton.desc"
        />
    </div>
</div>
