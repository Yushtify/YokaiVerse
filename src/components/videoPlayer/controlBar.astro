---
import SubtitleBar from "./subtitleBar.astro";

import Button from "../custom/buttons/Button.astro";
import CustomSlider from "../custom/customSlider.astro";
import TimelineSlider from "../custom/timelineSlider.astro";

// ------ Buttons ---------------------------------------------------------
import Settings from "./buttons/settings.astro";
---

<div
    id="controlBar"
    class="flex flex-col items-start justify-center w-full h-fit gap-4 z-2"
>
    <!--
    First Collumn:
    Will have; TimeStamp and Subtitles.
    -->
    <div class="flex flex-row w-full h-fit gap-4">
        <div
            class="flex flex-row items-center justify-between min-w-fit w-fit h-fit gap-4 p-2 px-4 rounded-full bg-L_Primary dark:bg-D_Primary text-[min(6vw,0.9rem)] text-LT_Primary dark:text-L_Primary text-nowrap overflow-hidden"
        >
            <div
                id="timeStamp"
                class="flex flex-row items-center justify-center gap-2 w-fit h-fit"
            >
                <span id="current_TimeStamp">00:00</span>
                <span>/</span>
                <span
                    id="duration_TimeStamp"
                    class="text-[min(5vw,0.8rem)] text-LT_Primary dark:text-DT_Primary"
                >
                    00:00</span
                >
            </div>
        </div>
        <SubtitleBar />
    </div>

    <!--
    Second Collumn:
    Will have; TimeStamp slider.
    -->
    <TimelineSlider givenID="timelineSlider" duration={90} />

    <!--
    Second Collumn:
    Will have; Every other control that a video player has.
    -->
    <div
        id="controls"
        class="flex flex-row items-center justify-between w-full h-fit gap-4 text-LT_Primary dark:text-L_Primary"
    >
        <!--
        First Row:
        Will have; Pause, Mute, Slider for Volume.
        -->
        <div
            class="group flex flex-row items-center justify-center gap-2 min-w-fit w-fit h-fit p-2 pr-0 hover:pr-4 rounded-3xl bg-L_Primary dark:bg-D_Primary text-[min(6vw,0.9rem)] text-nowrap overflow-hidden transition-normal duration-200 ease-in-out"
        >
            <Button
                givenLocationFrom="horizontal"
                givenLocation="start"
                givenButtonID="epPlayButton"
                givenButtonAction="playEp()"
                givenButtonSymbol="pause"
                givenButtonSymbolFill={true}
                tooltipDescTrans="tooltip.epPlayer.controlBar.pauseButton"
            />
            <Button
                givenLocationFrom="horizontal"
                givenLocation="end"
                givenButtonID="epMuteButton"
                givenButtonAction="muteEp()"
                givenButtonSymbol="volume_up"
                givenButtonSymbolFill={true}
                tooltipDescTrans="tooltip.epPlayer.controlBar.muteButton"
            />
            <CustomSlider
                givenID="volumeSlider"
                givenOnInput="updateVolume(value)"
                givenWidth="w-0 group-hover:w-17 transition-normal duration-200 ease-in-out"
                givenMin="0"
                givenMax="1"
                givenValue="1"
                givenStep="0.1"
            />
        </div>

        <!--
        First Row:
        Will have; Tranlations, Settings and Fullscreen.
        -->
        <div
            class="flex flex-row items-center justify-center gap-2 min-w-fit w-fit h-fit p-2 rounded-3xl bg-L_Primary dark:bg-D_Primary text-[min(6vw,0.9rem)] text-nowrap"
        >
            <Button
                givenLocationFrom="horizontal"
                givenLocation="start"
                givenButtonID="epSubtitlesButton"
                givenButtonAction="toggleSubtitles()"
                givenButtonSymbol="subtitles"
                givenButtonSymbolFill={true}
                tooltipDescTrans="tooltip.epPlayer.controlBar.subtitlesButton"
            />
            <Settings />
            <Button
                givenLocationFrom="horizontal"
                givenLocation="end"
                givenButtonID="epFullscreenButton"
                givenButtonAction="epFullscreenToggle()"
                givenButtonSymbol="expand_content"
                givenButtonSymbolFill={true}
                tooltipDescTrans="tooltip.epPlayer.controlBar.fullscreenButton"
            />
        </div>
    </div>
</div>
