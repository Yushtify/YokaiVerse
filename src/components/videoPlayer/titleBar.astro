---
import Button from "../custom/buttons/Button.astro";
---

<!-- Controls -->
<div
    id="titleBar"
    class="flex flex-row items-center justify-start w-full h-fit gap-4 text-LT_Primary dark:text-L_Primary z-2 overflow-hidden"
>
    <div
        class="flex flex-row items-center justify-center gap-2 w-fit h-fit p-2 md:p-4 px-4 md:px-6 rounded-full bg-L_Primary dark:bg-D_Primary text-[min(6vw,1rem)] text-nowrap overflow-hidden"
    >
        <p
            id="animeTitle"
            class="w-full rounded-full font-semibold text-left capitalize"
        >
            Untitled Anime
        </p>
        <span> : </span>
        <p
            id="episodeTitle"
            class="w-full rounded-full text-[min(6vw,1rem)] text-left capitalize"
        >
            Untitled Episode
        </p>
    </div>
</div>
