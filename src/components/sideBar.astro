---
import GoogleMaterialSymbol from "./custom/googleMaterial_Symbol.astro";

interface Props {
    givenSymbol: string;
    givenTitle: string;
    givenTitleData: string;
}

const { givenSymbol, givenTitle, givenTitleData } = Astro.props;
---

<div
    class="flex flex-col items-start justify-start gap-6 w-fit max-w-screen h-fit md:h-screen text-[min(6vw,0.9rem)] text-LT_Primary dark:text-DT_Primary"
>
    <div class="flex flex-row items-center justify-start gap-4 w-full h-fit">
        <GoogleMaterialSymbol
            symbol={givenSymbol}
            SymbolSize="!text-[min(6vw,1.8rem)]"
            isFilled={true}
        />
        <p
            data-i18n={givenTitleData}
            class="font-bold text-[min(6vw,1.8rem)] capitalize"
        >
            {givenTitle}
        </p>
    </div>

    <!-- Navigation Container -->
    <div
        class="flex flex-row md:flex-col items-start justify-start gap-2 w-full h-fit overflow-scroll capitalize!"
    >
        <slot />
    </div>
</div>
