---
import ProgressChip from "../../custom/public/progressChip.astro";
import RoadmapItemTemplate from "./versionDetailTemplate.astro";
---

<template id="roadmapCardTemplate">
    <div
        id="roadmapCard_Root"
        class="flex flex-col items-center justify-center gap-4 p-4 md:p-8 rounded-3xl w-full h-fit bg-L_Primary dark:bg-D_Primary text-[min(7vw,1rem)] text-LT_Primary dark:text-DT_Primary transition-colors duration-250 ease-in-out"
    >
        <!-- Card Header -->
        <div
            class="flex flex-col items-start justify-center w-full h-fit gap-1"
        >
            <div
                class="flex flex-row items-center justify-start gap-3 w-full h-fit flex-wrap"
            >
                <p
                    id="roadmap_Milestone"
                    class="font-semibold text-[min(7vw,1.4rem)] uppercase"
                >
                    v0.4.0
                </p>
                <ProgressChip givenID="roadmap_StatusBadge" />
            </div>
            <p
                id="roadmap_ETA"
                class="text-[min(7vw,0.8rem)] text-LT_Tertiary dark:text-DT_Tertiary"
            >
                ETA: Q3 2026
            </p>
            <p
                id="roadmap_Description"
                class="text-[min(7vw,1rem)] text-LT_Secondary dark:text-DT_Secondary mt-1"
            >
                Description here.
            </p>
        </div>

        <!-- Items List -->
        <div
            id="roadmapItemList"
            class="flex flex-col items-start justify-center gap-3 p-6 rounded-3xl w-full h-full bg-L_BG dark:bg-D_BG"
        >
            <RoadmapItemTemplate />
        </div>
    </div>
</template>
