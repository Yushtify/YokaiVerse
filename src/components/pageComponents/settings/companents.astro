---
import Body from "../../../layouts/sidebar.astro";

import SideBar from "../../sideBar.astro";
import SettingsNavigator from "../../custom/buttons/navigatorRadio.astro";

import SettingTabs from "./tabs/tabs.astro";
---

<Body>
    <SideBar
        givenSymbol="settings"
        givenTitle="settings"
        givenTitleData="settings.hero.title"
    >
        <SettingsNavigator
            givenID="generalSettings_radio"
            givenRadGroup="settingsNavigator"
            givenCanDisabled={false}
            givenState={true}
            givenSymbol="tune"
            givenTitle="General"
            titleData="settings.hero.quickLinks.general"
        />
        <SettingsNavigator
            givenID="accountSettings_radio"
            givenRadGroup="settingsNavigator"
            givenCanDisabled={false}
            givenState={false}
            givenSymbol="person"
            givenTitle="Account"
            titleData="settings.hero.quickLinks.account"
        />
        <SettingsNavigator
            givenID="privacySettings_radio"
            givenRadGroup="settingsNavigator"
            givenCanDisabled={false}
            givenState={false}
            givenSymbol="shield_lock"
            givenTitle="Privacy"
            titleData="settings.hero.quickLinks.privacy"
        />
        <SettingsNavigator
            givenID="appearanceSettings_radio"
            givenRadGroup="settingsNavigator"
            givenCanDisabled={false}
            givenState={false}
            givenSymbol="palette"
            givenTitle="Appearance"
            titleData="settings.hero.quickLinks.appearance"
        />
        <SettingsNavigator
            givenID="experimentalSettings_radio"
            givenRadGroup="settingsNavigator"
            givenCanDisabled={false}
            givenState={false}
            givenSymbol="science"
            givenTitle="experimental"
            titleData="settings.hero.quickLinks.experimental"
        />
    </SideBar>
    <div
        class="flex flex-col items-start justify-start w-full h-fit max-h-screen"
    >
        <SettingTabs />
    </div>
</Body>

<script>
    import "./scripts/settingsControls.ts"; // controls every setting in the settings page
    import "./scripts/settingsNavigator.ts"; // contorls the navigation between settings tabs
</script>
