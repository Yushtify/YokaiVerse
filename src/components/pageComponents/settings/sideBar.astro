---
import GoogleMaterialSymbol from "../../custom/googleMaterial_Symbol.astro";
import RadioButton from "./settingsNavigator.astro";
---

<div
    class="flex flex-col items-start justify-start gap-6 w-fit max-w-screen h-fit md:h-screen text-[min(6vw,0.9rem)] text-LT_Primary dark:text-DT_Primary"
>
    <div class="flex flex-row items-center justify-start gap-4 w-full h-fit">
        <GoogleMaterialSymbol
            symbol="settings"
            SymbolSize="!text-[min(6vw,1.8rem)]"
            isFilled={true}
        />
        <p
            data-i18n="settings.hero.title"
            class="font-bold text-[min(6vw,1.8rem)] capitalize"
        >
            Settings
        </p>
    </div>

    <!-- Navigation Container -->
    <div
        class="flex flex-row md:flex-col items-start justify-start gap-2 w-full h-fit overflow-x-scroll md:overflow-y-scroll overflow-hidden capitalize!"
    >
        <RadioButton
            givenID="generalSettings_radio"
            givenRadGroup="settingsNavigator"
            givenCanDisabled={false}
            givenState={true}
            givenSymbol="tune"
            givenTitle="General"
            titleData="settings.hero.quickLinks.general"
        />
        <RadioButton
            givenID="accountSettings_radio"
            givenRadGroup="settingsNavigator"
            givenCanDisabled={false}
            givenState={false}
            givenSymbol="person"
            givenTitle="Account"
            titleData="settings.hero.quickLinks.account"
        />
        <RadioButton
            givenID="privacySettings_radio"
            givenRadGroup="settingsNavigator"
            givenCanDisabled={false}
            givenState={false}
            givenSymbol="shield_lock"
            givenTitle="Privacy"
            titleData="settings.hero.quickLinks.privacy"
        />
        <RadioButton
            givenID="appearanceSettings_radio"
            givenRadGroup="settingsNavigator"
            givenCanDisabled={false}
            givenState={false}
            givenSymbol="palette"
            givenTitle="Appearance"
            titleData="settings.hero.quickLinks.appearance"
        />
        <RadioButton
            givenID="experimentalSettings_radio"
            givenRadGroup="settingsNavigator"
            givenCanDisabled={false}
            givenState={false}
            givenSymbol="science"
            givenTitle="experimental"
            titleData="settings.hero.quickLinks.experimental"
        />
    </div>
</div>
