---
import TabTemplate from "./tabTemplate.astro";

import RadioButton from "../../../custom/buttons/radioButton.astro";
---

<TabTemplate
    givenLocationFrom="vertical"
    givenLocation="center"
    givenContentAlign="grid"
    givenTabID="appearanceTab"
    givenSymbol="palette"
    givenTitle="appearance"
    titleData="settings.tabs.appearance.title"
    givenDesc="Customize themes, accent colors, and the general user interface."
    descData="settings.tabs.appearance.desc"
>
    <!-- Theme switcher -->
    <div
        class="flex flex-col md:flex-row items-start justify-center gap-6 pl-6 p-4 rounded-3xl min-w-fit w-fit max-w-full bg-L_Primary dark:bg-D_Primary"
    >
        <!-- Header -->
        <div
            class:list="flex flex-col items-center justify-center gap-2 min-w-fit w-fit h-fit"
        >
            <p
                data-i18n="settings.tabs.appearance.contents.theme.title"
                class="font-semibold capitalize text-[min(6vw,1.6rem)]"
            >
                Theme
            </p>
            <p
                data-i18n="settings.tabs.appearance.contents.theme.desc"
                class="min-w-[18.5rem]"
            >
                Change website theme to your liking or leave it on system
            </p>
        </div>

        <!-- Switchers -->
        <div
            class="flex flex-row items-start justify-start gap-2 p-2 rounded-3xl bg-L_BG dark:bg-D_BG border border-LB_Primary dark:border-DB_Primary"
        >
            <RadioButton
                givenPositionTo="horizontal"
                givenPosition="start"
                givenID="themeAuto_radio"
                givenRadGroup="webTheme"
                givenCanDisabled={true}
                givenState={false}
                givenSymbol="computer"
            />
            <RadioButton
                givenPositionTo="horizontal"
                givenPosition="center"
                givenID="themeLight_radio"
                givenRadGroup="webTheme"
                givenCanDisabled={true}
                givenState={false}
                givenSymbol="light_mode"
            />
            <RadioButton
                givenPositionTo="horizontal"
                givenPosition="end"
                givenID="themeDark_radio"
                givenRadGroup="webTheme"
                givenCanDisabled={true}
                givenState={false}
                givenSymbol="dark_mode"
            />
        </div>
    </div>
</TabTemplate>
