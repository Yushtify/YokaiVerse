---
import ThemeSwitcherRadio from "../../../../custom/buttons/themeSwitcherRadio.astro";
---

<!-- Theme switcher -->
<div
  class="flex flex-col items-center justify-center gap-4 lg:gap-6 w-fit h-fit"
>
  <div class="flex flex-col items-start justify-center w-full h-fit">
    <p class="font-semibold text-[min(7vw,1.6rem)] uppercase">Theme</p>
    <p
      class="text-[min(7vw,1rem)] text-Light_Text_Secondary dark:text-Dark_Text_Secondary"
    >
      Change the theme to your liking.
    </p>
  </div>
  <div
    class="flex flex-row flex-wrap items-start justify-start gap-8 w-full h-fit p-2"
  >
    <ThemeSwitcherRadio
      givenID="SystemMode_Switch"
      groupName="ThemeSwitcher"
      givenGoogleSymbol="computer"
      givenTitle="System Mode"
      givenDesc="sync the theme with your system or browser."
      givenState={true}
    />
    <ThemeSwitcherRadio
      givenID="DarkMode_Switch"
      groupName="ThemeSwitcher"
      givenGoogleSymbol="dark_mode"
      givenTitle="Dark Mode"
      givenDesc="manually set your theme to dark mode."
      givenState={false}
    />
    <ThemeSwitcherRadio
      givenID="LightMode_Switch"
      groupName="ThemeSwitcher"
      givenGoogleSymbol="light_mode"
      givenTitle="Light Mode"
      givenDesc="manually set your theme to light mode."
      givenState={false}
    />
    <ThemeSwitcherRadio
      givenID="MuheheheMode_Switch"
      groupName="ThemeSwitcher"
      givenGoogleSymbol="emoticon"
      givenTitle="Muhehehe Mode"
      givenDesc="manually set your theme to Muhehehe mode."
      givenState={false}
    />
  </div>
</div>
