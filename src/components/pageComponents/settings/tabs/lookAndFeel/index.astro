---
import ThemeSwitcher from "./themeSwitcher.astro";

const TabTitle = "Appereance";
const DivRelID = "appereance";
---

<div
  id={DivRelID}
  class="flex flex-col items-start justify-center gap-4 w-full h-fit text-[min(6vw,1rem)] text-Light_Text_Primary dark:text-Dark_Text_Primary hover:scale-102 transition-all duration-300 ease-in-out"
>
  <div
    class="flex flex-row items-center justify-between gap-2 w-full h-fit p-2 lg:p-4 xl:p-8 rounded-xl bg-Light_Secondary dark:bg-Dark_Secondary border border-Light_Border_Primary dark:border-Dark_Border_Primary text-[min(3vw,0.7rem)]"
  >
    <p
      class="flex flex-row items-center justify-start w-full gap-2 lg:gap-4 font-semibold text-[min(7vw,1.6rem)] capitalize"
    >
      <span
        id="googleSymbol"
        class="material-symbols-rounded !text-[min(7vw,2rem)] icon-fill"
        >palette</span
      >
      {TabTitle}
    </p>

    <button
      class="flex items-center justify-center h-full aspect-square ml-2 rounded-xl bg-Light_Primary dark:bg-Dark_Primary hover:bg-Light_Border_Primary hover:dark:bg-Dark_Border_Primary border border-Light_Border_Primary dark:border-Dark_Border_Primary text-Light_Text_Secondary/64 dark:text-Dark_Text_Secondary/64 hover:text-Accent transition-colors duration-300 ease-in-out cursor-pointer"
      onclick={`CollapseVersionLog('${DivRelID}', this, true)`}
    >
      <span id="googleSymbol" class="material-symbols-rounded"
        >keyboard_arrow_up</span
      >
    </button>
  </div>

  <div
    id="VersionLog_Container"
    class="relative flex flex-col items-start justify-start gap-2 w-full h-fit p-2 lg:p-4 xl:p-8 rounded-xl bg-Light_Secondary dark:bg-Dark_Secondary border border-Light_Border_Primary dark:border-Dark_Border_Primary text-[min(7vw,0.8rem)] capitalize overflow-hidden"
  >
    <ThemeSwitcher />

    <!-- Others -->
  </div>
</div>
