---
import GoogleMaterialSymbol from "../../../custom/googleMaterial_Symbol.astro";

interface Props {
    givenState: boolean;
    givenTabID: string;
    givenSymbol: string;
    givenTitle: string;
    titleData: string;
    givenDesc: string;
    descData: string;
}

const {
    givenState,
    givenTabID,

    givenSymbol,
    givenTitle,
    givenDesc,
    descData,
    titleData,
} = Astro.props;

const tabContentID = givenTabID + "_content";

const state = givenState ? "flex" : "hidden";
---

<div
    id={givenTabID}
    class={`${state} flex-col items-start justify-start gap-6 md:gap-8 w-full max-w-screen h-fit text-[min(6vw,0.9rem)] text-LT_Primary dark:text-DT_Primary transition-all duration-200 ease-in-out`}
>
    <!-- Header -->
    <div class="flex flex-col items-start justify-center gap-2 w-full h-fit">
        <div
            class="flex flex-row items-center justify-start gap-2 w-full h-fit"
        >
            <GoogleMaterialSymbol
                symbol={givenSymbol}
                SymbolSize="text-[min(6vw,1.4rem)]!"
                isFilled={true}
            />
            <p
                data-i18n={titleData}
                class="font-semibold text-[min(6vw,1.4rem)] capitalize"
            >
                {givenTitle}
            </p>
        </div>
        <p
            data-i18n={descData}
            class="text-LT_Secondary dark:text-DT_Secondary"
        >
            {givenDesc}
        </p>
    </div>
    <div
        id={tabContentID}
        class="flex flex-col items-start justify-start gap-8 w-full h-fit"
    >
        <slot />
    </div>
</div>
