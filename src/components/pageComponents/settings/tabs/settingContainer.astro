---
interface Props {
    givenTitle: string;
    titleData: string;
}

const { givenTitle, titleData } = Astro.props;
---

<div
    class="flex flex-col items-items-start justify-start w-full h-fit gap-2 overflow-hidden"
>
    <div class="flex flex-col items-items-start justify-start w-full h-fit">
        <p
            data-i18n={titleData}
            class="w-full text-left font-semibold text-[min(6vw,0.8rem)] text-LT_Secondary dark:text-DT_Secondary capitalize"
        >
            {givenTitle}
        </p>
    </div>

    <div
        class="flex flex-col items-items-start justify-start w-full h-fit gap-4 overflow-hidden"
    >
        <slot />
    </div>
</div>
