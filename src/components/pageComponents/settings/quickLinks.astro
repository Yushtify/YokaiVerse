---
import GoogleMaterialSymbol from "../../custom/googleMaterial_Symbol.astro";
---

<div
  class="relative flex flex-col items-start justify-center w-full h-fit pt-4 text-left text-[min(4vw,1rem)] text-Light_Text_Primary dark:text-Dark_Text_Primary"
>
  <div
    class="flex flex-row items-center justify-start w-full h-fit gap-4 py-4 text-[min(7vw,1rem)] text-Light_Text_Primary dark:text-Dark_Text_Primary overflow-hidden max-xl:overflow-x-scroll"
  >
    <a
      href="#appereance"
      class="flex flex-row items-center justify-center min-w-48 w-fit h-fit p-4 rounded-xl gap-2 bg-Light_Secondary dark:bg-Dark_Secondary hover:bg-Light_Border_Primary hover:dark:bg-Dark_Border_Primary border border-Light_Border_Primary dark:border-Dark_Border_Primary hover:border-transparent outline-0 hover:outline-1 hover:outline-offset-2 outline-Light_Border_Primary dark:outline-Dark_Border_Primary font-medium text-Light_Text_Secondary dark:text-Dark_Text_Secondary hover:text-Accent capitalize text-nowrap transition-colors duration-300 ease-in-out cursor-pointer"
    >
      <GoogleMaterialSymbol
        SVG_Name="palette"
        SvgSize="!text-[min(7vw,1.5rem)]"
      />
      <p>appereance</p>
    </a>
    <a
      href="#"
      class="flex flex-row items-center justify-center min-w-48 w-fit h-fit p-4 rounded-xl gap-2 bg-Light_Secondary dark:bg-Dark_Secondary hover:bg-Light_Border_Primary hover:dark:bg-Dark_Border_Primary border border-Light_Border_Primary dark:border-Dark_Border_Primary hover:border-transparent outline-0 hover:outline-1 hover:outline-offset-2 outline-Light_Border_Primary dark:outline-Dark_Border_Primary font-medium text-Light_Text_Secondary dark:text-Dark_Text_Secondary hover:text-Accent capitalize text-nowrap transition-colors duration-300 ease-in-out cursor-pointer"
    >
      <GoogleMaterialSymbol
        SVG_Name="shield"
        SvgSize="!text-[min(7vw,1.5rem)]"
      />
      <p>privacy & security</p>
    </a>
    <a
      href="#"
      class="flex flex-row items-center justify-center min-w-48 w-fit h-fit p-4 rounded-xl gap-2 bg-Light_Secondary dark:bg-Dark_Secondary hover:bg-Light_Border_Primary hover:dark:bg-Dark_Border_Primary border border-Light_Border_Primary dark:border-Dark_Border_Primary hover:border-transparent outline-0 hover:outline-1 hover:outline-offset-2 outline-Light_Border_Primary dark:outline-Dark_Border_Primary font-medium text-Light_Text_Secondary dark:text-Dark_Text_Secondary hover:text-Accent capitalize text-nowrap transition-colors duration-300 ease-in-out cursor-pointer"
    >
      <GoogleMaterialSymbol
        SVG_Name="person"
        SvgSize="!text-[min(7vw,1.5rem)]"
      />
      <p>account</p>
    </a>
  </div>
</div>
