---
import CardLink from "../../custom/links/cardLink.astro";
---

<div
    class="flex flex-row flex-wrap gap-4 items-center justify-start w-full max-w-screen h-fit"
>
    <CardLink
        givenID="general-settings"
        givenHREF="#generalTab"
        givenGoogleSymbol="tune"
        givenTitle="general"
        titleData="settings.hero.quickLinks.general"
    />
    <CardLink
        givenID="account-settings"
        givenHREF="#accountTab"
        givenGoogleSymbol="person"
        givenTitle="account"
        titleData="settings.hero.quickLinks.account"
    />
    <CardLink
        givenID="privacy-settings"
        givenHREF="#privacyTab"
        givenGoogleSymbol="shield_lock"
        givenTitle="privacy"
        titleData="settings.hero.quickLinks.privacy"
    />
    <CardLink
        givenID="appearance-settings"
        givenHREF="#appearanceTab"
        givenGoogleSymbol="palette"
        givenTitle="appearance"
        titleData="settings.hero.quickLinks.appearance"
    />
    <CardLink
        givenID="experimental-settings"
        givenHREF="#experimentalTab"
        givenGoogleSymbol="science"
        givenTitle="experimental"
        titleData="settings.hero.quickLinks.experimental"
    />
</div>
