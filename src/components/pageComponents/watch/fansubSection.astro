---
import Button from "../../custom/buttons/customRadioButton.astro";
---

<div
  class="flex flex-col items-center justify-start rounded-xl p-4 gap-2 w-full h-fit border border-Light_Border_Primary dark:border-Dark_Border_Primary overflow-hidden"
>
  <div class="flex flex-row items-center justify-start gap-4 px-2 h-fit w-full">
    <p
      class="flex h-fit w-fit text-[min(6vw,1.2rem)] text-nowrap text-Light_Text_Primary dark:text-Dark_Text_Primary capitalize font-semibold"
    >
      Choose a Language:
    </p>
    <p
      id="activeFansubDisplay"
      class="flex h-fit w-fit text-[min(6vw,0.95rem)] text-nowrap text-Light_Text_Secondary dark:text-Dark_Text_Secondary capitalize font-semibold"
    >
      None
    </p>
  </div>

  <!-- Lang Radio -->
  <div
    class="flex max-sm:flex-col sm:flex-row items-start justify-start gap-2 h-fit w-full overflow-x-scroll overflow-y-hidden"
  >
    <Button givenState={true} givenID="a" groupName="fansubSelection"
      >English - EN</Button
    >
    <Button givenState={false} givenID="a" groupName="fansubSelection"
      >Turkish - TR</Button
    >
  </div>
</div>
