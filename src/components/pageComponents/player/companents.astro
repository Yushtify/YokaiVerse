---
import ContentWrapper from "./wrapper.astro";
import CustomVideoPlayer from "../../custom/videoPlayer/customVideoPlayer.astro";

// Things Releated to Video And that's seperated into same root with this file.
import DescriptionSlot from "./descriptionSection.astro";
import VideoInfoSlot from "./videoInfoSection.astro";
import FansubSlot from "./fansubSection.astro";
---

<ContentWrapper>
  <!-- Video Player title and so on -->
  <div
    class="flex flex-col items-start justify-start w-full lg:min-w-[70%] lg:w-fit gap-4"
  >
    <CustomVideoPlayer />
    <div
      class="flex flex-col items-start justify-start px-4 gap-4 w-full h-fit text-[min(6vw,0.9rem)] text-left text-Light_Text_Secondary/64 dark:text-Dark_Text_Secondary/64"
    >
      <!-- Description -->
      <VideoInfoSlot />
      <DescriptionSlot />
      <FansubSlot />

      <!-- The Fansub Selection -->
    </div>
  </div>

  <!-- The rec videos / next ep -->
  <div class="flex flex-col items-start justify-start w-full gap-4"></div>
</ContentWrapper>
