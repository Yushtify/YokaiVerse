---
import Body from "../../../layouts/default.astro";
import Lister from "../public/lister.astro";
import Hero from "./hero.astro";
---

<Body>
    <Hero />

    <!-- Lister template — not visible, used by the featuredHandler -->
    <Lister givenID="anime" />
    <Lister givenID="manga" />
    <div
        class="flex flex-col items-start justify-start gap-12 w-full h-fit"
        id="animeListerContainer"
    >
    </div>
    <div
        class="flex flex-col items-start justify-start gap-12 w-full h-fit"
        id="mangaListerContainer"
    >
    </div>
</Body>

<script>
    import "./featuredFilter.ts"; // handles the navigation and filtering in the featured.
    import "../../../scripts/featured/featuredHandler"; // handles the load on featured.
</script>
