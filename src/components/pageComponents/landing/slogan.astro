<div
  class="absolute bottom-0 flex flex-row items-center justify-center w-full h-fit p-2 md:p-4 md:px-16 bg-Light_Secondary dark:bg-Dark_Secondary border-y border-Light_Border_Primary dark:border-Dark_Border_Primary mask-[linear-gradient(to_right,transparent,black_15%,black_85%,transparent)] [-webkit-mask-image:linear-gradient(to_right,transparent,black_15%,black_85%,transparent)]"
>
  <p
    id="heroSlogan"
    class="text-[min(6vw,1rem)] text-Light_Text_Secondary dark:text-Dark_Text_Secondary text-center"
  >
    Merhaba Dünya!
  </p>
</div>

<script>
  (window as any).textAnim = async function (
    element: any,
    newText: string,
    speed: number = 10
  ) {
    // Function to animate text change in the dialog
    // Delete current text one by one
    if (element.innerHTML === newText) return;
    else {
      let current = element.innerHTML;
      for (let i = current.length; i >= 0; i--) {
        element.innerHTML = current.slice(0, i);
        await new Promise((res) => setTimeout(res, speed));
      }
      // Add new text one by one
      for (let i = 1; i <= newText.length; i++) {
        element.innerHTML = newText.slice(0, i);
        await new Promise((res) => setTimeout(res, speed));
      }
    }
  };

  type SloganClass = "common" | "rare" | "mythic" | "mysterious" | "gambleCore";

  interface SloganTexts {
    default: string[];
    eastereggs: Record<SloganClass, string[]>;
  }

  interface sloganCounterValidator {
    // validator fot slogan Counter
    saveEnabled: boolean;
    sloganLog: boolean;
    default: number;
    easterEgg: {
      common: number;
      rare: number;
      mythic: number;
      mysterious: number;
      gambleCore: number;
    };
    rarity: string;
    sloganClass: string;
    sloganText: string;
    sloganSpawnBY: string;
    sloganForced: number;
    sloganForceMAX: number;
  }

  var sloganCounter: sloganCounterValidator = {
    saveEnabled: true,
    sloganLog: false,
    default: 0,
    easterEgg: {
      common: 0,
      rare: 0,
      mythic: 0,
      mysterious: 0,
      gambleCore: 0,
    },
    rarity: "",
    sloganClass: "",
    sloganText: "",
    sloganSpawnBY: "Script",
    sloganForced: 0,
    sloganForceMAX: 5,
  };

  interface lastSloganValidator {
    last: string;
  }
  var LastSlogan: lastSloganValidator = {
    last: "",
  };

  let timer: number = 1000 * 20; // 20 seconds delay between text changes
  let textSpeed: number = 7.5;

  interface SloganTexts {
    default: string[];
    eastereggs: {
      common: string[];
      rare: string[];
      mythic: string[];
      mysterious: string[];
      gambleCore: string[];
    };
  }

  const sloganTexts: SloganTexts = {
    default: [
      "Explore Anime, Manga, Webtoon. Without annoying ads or sponsorships.",
      "Fastest way to start exploring, all without ads.",
      "Safety concerns? No problem even we don't know what you watch.",
      "Dive into YokaiVerse explore everything without limits, without being tracked or being sold.",
      "YokaiVerse, Who cares about users not AI or ADS",
      "YokaiVerse, where safety, privacy and user's is the priority",
      "Tired of Google, Microsoft, and companies like them choking you for profit? Come here — we care about you, not your wallet.",
    ],
    eastereggs: {
      common: [
        "Flint and Steeeeeeeeeeeeel!",
        "ඞඞඞඞඞඞඞඞඞඞඞඞ",
        "I-Is that Google!!!!?",
        "Heh got your browsing history :)",
      ],
      rare: [
        "Am I seeing right? Is that Windows 11 without tracking...? oh it was a dream.... They got me for a second.",
        "REMINDER! Drink some water",
        '<img src="/Logo.svg" alt="YokaiVerse Logo" class="logoImage">',
      ],
      mythic: ["I dunno, I ran out of ideas lol."],
      mysterious: [
        "A Japanese legend once said: 'nigg-' Ehm.. 'Niggeria'",
        'Miku Miku Bea- 💥 <img src="/images/hatsuneMiku.png" alt="Boy" class="easterEggImageGif">',
      ],
      gambleCore: [
        "777",
        "LET'S GO GAMBLING",
        "AH DANG IT!",
        "I CAN'T STOP WINNING!",
      ],
    },
  };

  function saveSloganJSON(config: any) {
    // Save Theme (JSON)
    if (!sloganCounter.saveEnabled)
      return console.warn("Saving for sloganJSON is disabled.");
    try {
      // try to save the JSON
      localStorage.setItem("sloganCounterConfig", JSON.stringify(config));
      return;
    } catch (error) {
      console.error(error);
    }
  }

  function loadSloganJSON() {
    // Load the Theme (JSON)
    const saved = localStorage.getItem("sloganCounterConfig");
    if (saved) {
      try {
        // try to loadTheme
        const parsed = JSON.parse(saved) as sloganCounterValidator;
        Object.assign(sloganCounter, parsed);
      } catch (e) {
        console.error(
          "Saved sloganJSON config is corrupted or invalid. Clearing saved data.",
          e
        );
        localStorage.removeItem("sloganCounterConfig"); // Clear corrupted data
      }
    }
  }

  function updateLastSlogan(newValidSlogan: string) {
    // updating last valid slogan.
    if (LastSlogan.last == newValidSlogan) return sloganSelector();
    LastSlogan.last = newValidSlogan;
    sloganCounter.sloganText = newValidSlogan;

    saveSloganJSON(sloganCounter);
  }

  function sloganRandomNumberGenerator() {
    // just a random number generator.
    const RandomNum: number = Math.floor(Math.random() * 1000001); // Generate a random index between 0 and 1.000.001
    return RandomNum;
  }

  function logSlogan(byConsole: boolean) {
    if (!sloganCounter.sloganLog && !byConsole) return;
    console.log(
      "Slogan Text: " +
        sloganCounter.sloganText +
        "\n" +
        "Slogan Class: " +
        sloganCounter.sloganClass +
        "\n" +
        "Slogan Rarity: " +
        sloganCounter.rarity +
        "\n" +
        "Slogan Spawn BY: " +
        sloganCounter.sloganSpawnBY +
        "\n" +
        "Slogan Force Limit: " +
        sloganCounter.sloganForceMAX +
        "\n" +
        "Slogan Forced " +
        sloganCounter.sloganForced +
        " Times." +
        "\n" +
        "\n" +
        "Defualt Slogan " +
        sloganCounter.default +
        " Times" +
        "\n" +
        "Easter Egg (common) " +
        sloganCounter.easterEgg.common +
        " Times" +
        "\n" +
        "Easter Egg (rare) " +
        sloganCounter.easterEgg.rare +
        " Times" +
        "\n" +
        "Easter Egg (mythic) " +
        sloganCounter.easterEgg.mythic +
        " Times" +
        "\n" +
        "Easter Egg (mysterious) " +
        sloganCounter.easterEgg.mysterious +
        " Times" +
        "\n" +
        "Easter Egg (gambleCore) " +
        sloganCounter.easterEgg.gambleCore +
        " Times"
    );
  }

  function spawnSlogan() {
    // choosing the slogan out of the sloganClass.
    const heroSlogan = document.getElementById(
      "heroSlogan"
    ) as HTMLParagraphElement;
    var newSlogan: any;
    var randomNumber: number;

    if (sloganCounter.sloganClass.match("default")) {
      // if default came.
      randomNumber = Math.floor(Math.random() * sloganTexts.default.length);
      newSlogan = sloganTexts.default[randomNumber];
    } else {
      // if default did not come.
      const sloganClassName = sloganCounter.sloganClass as SloganClass;
      randomNumber = Math.floor(
        Math.random() * sloganTexts.eastereggs[sloganClassName].length
      );
      newSlogan = sloganTexts.eastereggs[sloganClassName][randomNumber];
    }

    if (newSlogan == LastSlogan.last) return sloganSelector(); // if same thing returned then go and make new one.

    window.textAnim(heroSlogan, newSlogan, textSpeed); // animate the slogan into life! // burada hata var. Cannot find name 'textAnim'.ts(2304)any

    updateLastSlogan(newSlogan); // save it to last slogan so it doesn't happens to come back :3
    logSlogan(false);
  }

  function sloganSelector() {
    // This is where slogan will be choosen.
    var randomNumber = sloganRandomNumberGenerator();
    var choosen: string = "";

    if (randomNumber === 0) {
      // Mysterious Easter Eggs

      choosen = "mysterious";
      sloganCounter.easterEgg.mysterious += 1;
    } else if (randomNumber <= 5) {
      choosen = "mythic";
      sloganCounter.easterEgg.mythic += 1;
    } else if (randomNumber <= 12500) {
      // Rare Easter Eggs

      choosen = "rare";
      sloganCounter.easterEgg.rare += 1;
    } else if (randomNumber === 777) {
      choosen = "gambleCore";
      sloganCounter.easterEgg.gambleCore += 1;
    } else if (randomNumber <= 75000) {
      // If the random index is 1000, Easter egg

      choosen = "common";
      sloganCounter.easterEgg.common += 1;
    } else {
      choosen = "default";
      sloganCounter.default += 1;
    }

    sloganCounter.sloganSpawnBY = "Script";
    sloganCounter.sloganClass = choosen;
    sloganCounter.rarity = randomNumber + " in 1.000.000";
    spawnSlogan();
  }

  function startSloganRotation() {
    sloganSelector(); // Call the function to set the initial slogan
    setInterval(sloganSelector, timer); // Set an interval to change the slogan every 25 seconds
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", loadSloganJSON);
    document.addEventListener("DOMContentLoaded", startSloganRotation);
  } else {
    loadSloganJSON();
    startSloganRotation();
  }

  function forceSpawn(value: string) {
    if (
      sloganCounter.sloganForceMAX === sloganCounter.sloganForced ||
      sloganCounter.sloganForceMAX <= sloganCounter.sloganForced
    )
      return console.log(
        `%cYou've reached your limits.!`,
        "color: red; font-weight: bold; font-size: 32px;"
      );

    sloganCounter.sloganClass = value;
    sloganCounter.sloganSpawnBY = "Force Spawn by Console.";
    sloganCounter.sloganForced += 1;

    spawnSlogan();
  }

  function forceAddLimits(value: number) {
    console.log(
      `%cHmm.. okie daddy!`,
      "color: hotpink; font-weight: bold; font-size: 32px;"
    );
    sloganCounter.sloganForceMAX = value;
  }
  (window as any).forceSpawn = forceSpawn;
  (window as any).forceAddLimits = forceAddLimits;

  addEventListener("DOMContentLoaded", function () {
    startSloganRotation();
  });
</script>
