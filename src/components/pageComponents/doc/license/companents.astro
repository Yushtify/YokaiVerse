                    class="my-2 text-LT_Primary dark:text-DT_Primary"
                    data-i18n="doc.license.modifiedSource.paragraph_1"
                >
                    You may convey a work based on the Program, or the
                    modifications to produce it from the Program, in the form of
                    source code under the terms of section 4, provided that you
                    also meet prominent notices of modification, licensing of
                    the entire work under this License, and displaying
                    Appropriate Legal Notices on interactive interfaces.
                </p>
            </CollapsibleNumericList>

            <CollapsibleNumericList
                givenID="NonSourceForms"
                givenNumber="7"
                givenHeader="Conveying Non-Source Forms"
                data="doc.license.nonSourceForms.header"
            >
                <p
                    class="my-2 text-LT_Primary dark:text-DT_Primary"
                    data-i18n="doc.license.nonSourceForms.paragraph_1"
                >
                    You may convey a covered work in object code form under the
