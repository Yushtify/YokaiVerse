---
import AnumericList from "../../../custom/markdownElements/AnumericList.astro";
import NumericList from "../../../custom/markdownElements/NumericList.astro";
import CollapsibleNumericList from "../../../custom/markdownElements/CollapsibleNumericList.astro";
import HeaderText from "../../../custom/markdownElements/headerText.astro";
import Body from "../../../pageContent_Wrappers/default.astro";

import Hero from "./hero.astro";
---

<Body>
