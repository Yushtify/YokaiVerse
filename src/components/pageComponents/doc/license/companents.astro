            </CollapsibleNumericList>

            <CollapsibleNumericList
                givenID="AntiCircumvention"
                givenNumber="4"
                givenHeader="Protecting Users' Legal Rights From Anti-Circumvention Law"
                data="doc.license.antiCircumvention.header"
            >
                <p
                    class="my-2 text-LT_Primary dark:text-DT_Primary"
                    data-i18n="doc.license.antiCircumvention.paragraph_1"
