            <CollapsibleNumericList
                givenID="AdditionalTerms"
                givenNumber="8"
                givenHeader="Additional Terms"
                data="doc.license.additionalTerms.header"
            >
                <p
                    class="my-2 text-LT_Primary dark:text-DT_Primary"
