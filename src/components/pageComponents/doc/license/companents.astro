                givenID="Termination"
                givenNumber="9"
                givenHeader="Termination"
                data="doc.license.termination.header"
            >
                <p
                    class="my-2 text-LT_Primary dark:text-DT_Primary"
                    data-i18n="doc.license.termination.paragraph_1"
