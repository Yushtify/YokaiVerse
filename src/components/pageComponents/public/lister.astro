---
interface Props {
    givenID: string;
}

const { givenID } = Astro.props;

import AnimeCard from "../../custom/buttons/animeCard/companents.astro";
import Button from "../../custom/buttons/Button.astro";
import RadioButton from "../../custom/buttons/radioButton.astro";
import GoogleMaterialSymbol from "../../custom/googleMaterial_Symbol.astro";

const ListerID = givenID + "Lister";
const cardListerID = givenID + "CardLister";
---

<template id={ListerID}>
    <div
        id="Lister"
        class="flex flex-col items-start justify-center gap-8 w-full h-fit text-[min(6vw,0.9rem)] text-LT_Primary dark:text-DT_Primary"
    >
        <!-- Lister Header -->
        <div
            class="flex flex-col items-start justify-start md:flex-row md:items-end md:justify-between w-full h-fit gap-4"
        >
            <div
                class="flex flex-col w-fit max-w-full h-fit items-start justify-center gap-2"
            >
                <div
                    class="flex flex-row items-center justify-start gap-4 w-fit max-w-full h-fit"
                >
                    <GoogleMaterialSymbol
                        SVG_ID="listerSVG"
                        symbol="star"
                        isFilled={true}
                        SymbolSize="!text-[min(6vw,2rem)]"
                    />
                    <p
                        id="listerTitle"
                        class="font-bold text-[min(6vw,1.6rem)] capitalize"
                    >
                        Title
                    </p>
                </div>
                <p
                    id="listerDesc"
                    class="flex w-fit text-LT_Secondary dark:text-DT_Secondary"
                >
                    Desc
                </p>
            </div>

            <!-- Pagination Controls -->
            <div
                class="flex flex-row items-center justify-center gap-2 min-w-fit w-fit max-w-full h-fit"
            >
                <Button
                    givenLocationFrom="horizontal"
                    givenLocation="start"
                    givenButtonID="listerPrevPage"
                    givenButtonAction=""
                    givenTitle="Previous Page"
                    titleData="global.variable.prevPage"
                    givenButtonSymbol="chevron_backward"
                    givenButtonSymbolSize="!text-[min(6vw,1.2rem)]"
                />
                <Button
                    givenLocationFrom="horizontal"
                    givenLocation="end"
                    givenButtonID="listerNextPage"
                    givenButtonAction=""
                    givenButtonCustomClass="flex-row-reverse"
                    givenTitle="Next Page"
                    titleData="global.variable.nextPage"
                    givenButtonSymbol="chevron_forward"
                    givenButtonSymbolSize="!text-[min(6vw,1.2rem)]"
                />
            </div>
        </div>

        <!-- Card Grid -->
        <div
            id={cardListerID}
            class="grid grid-cols-[repeat(auto-fill,minmax(219px,1fr))] md:grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-4 w-full h-fit"
        >
            <AnimeCard />
        </div>
    </div>
</template>
