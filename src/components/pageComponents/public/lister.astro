---
import AnimeCard from "../../custom/buttons/animeCard/companents.astro";
import Button from "../../custom/buttons/Button.astro";
import GoogleMaterialSymbol from "../../custom/googleMaterial_Symbol.astro";
---

<template id="animeLister">
    <div
        id="Lister"
        class="flex flex-col items-start justify-center gap-8 w-full h-fit text-[min(5vw,1rem)] text-LT_Primary dark:text-DT_Primary"
    >
        <!-- Lister Header -->
        <div
            class="flex flex-row flex-wrap items-center justify-start w-full h-fit gap-4"
        >
            <div class="flex flex-col w-full h-fit items-start justify-center">
                <div
                    class="flex flex-row items-center justify-start gap-4 w-full h-fit"
                >
                    <GoogleMaterialSymbol
                        SVG_ID="listerSVG"
                        symbol="star"
                        isFilled={true}
                        SvgSize="!text-[min(6vw,2rem)]"
                    />
                    <p
                        id="listerTitle"
                        class="font-bold text-[min(6vw,2rem)] capitalize text-nowrap"
                    >
                        Title
                    </p>
                </div>
                <p
                    id="listerDesc"
                    class="flex w-full lg:max-w-[80%] xl:max-w-[65%] text-LT_Secondary dark:text-DT_Secondary"
                >
                    Desc
                </p>
            </div>

            <!-- Pagination Controls -->
            <div
                class="flex flex-row items-center justify-center gap-2 min-w-fit w-fit max-w-full h-fit"
            >
                <Button
                    givenLocationFrom="horizontal"
                    givenLocation="start"
                    givenButtonID="listerPrevPage"
                    givenButtonAction=""
                    givenTitle="Previous Page"
                    titleData="global.lister.prevPage"
                    givenButtonSymbol="chevron_backward"
                    givenButtonSymbolSize="text-[min(7vw,1rem)]"
                />
                <Button
                    givenLocationFrom="horizontal"
                    givenLocation="end"
                    givenButtonID="listerNextPage"
                    givenButtonAction=""
                    givenButtonCustomClass="flex-row-reverse"
                    givenTitle="Next Page"
                    titleData="global.lister.nextPage"
                    givenButtonSymbol="chevron_forward"
                    givenButtonSymbolSize="text-[min(7vw,1rem)]"
                />
            </div>
        </div>

        <!-- Card Grid -->
        <div
            id="animeCardLister"
            class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 items-start justify-start gap-4 w-full h-fit"
        >
            <AnimeCard />
        </div>
    </div>
</template>
