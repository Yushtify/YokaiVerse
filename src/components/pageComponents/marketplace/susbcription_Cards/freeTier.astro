---
import Horizontal from "../../../seperators/horizontal.astro";

import ADS from "./subscriptionCards_Pros/ads.astro";
import NonPersonalizedADS from "./subscriptionCards_Pros/nonPersonalizedADS.astro";
import FasterDownloads from "./subscriptionCards_Pros/fasterDownload.astro";
import FasterUploads from "./subscriptionCards_Pros/fasterUpload.astro";
import FastConnection from "./subscriptionCards_Pros/fastConnection.astro";
import CloudStroage from "./subscriptionCards_Pros/cloudStorage.astro";
import Customization from "./subscriptionCards_Pros/customization.astro";
import Encryption from "./subscriptionCards_Pros/encryption.astro";
import PrioritySupport from "./subscriptionCards_Pros/prioritySupport.astro";
import EarlyAccess from "./subscriptionCards_Pros/earlyAccess.astro";
---

<div
  class="flex flex-col items-start justify-start w-full h-fit rounded-xl gap-4 p-2 hover:bg-Light_Secondary_Hover dark:hover:bg-Dark_Secondary_Hover border border-transparent hover:border-Light_Border_Secondary dark:hover:border-Dark_Border_Secondary hover:shadow-2xl hover:shadow-Light_Secondary_Hover dark:hover:shadow-Dark_Secondary_Hover transition-all duration-300 ease-in-out overflow-hidden"
>
  <div
    class="flex flex-row items-center justify-start w-full h-fit py-4 text-[min(10vw,6rem)]"
  >
    <span
      id="googleSymbol"
      class="material-symbols-rounded !text-[min(6vw,12rem)]"
      >volunteer_activism</span
    >
  </div>
  <p class="flex flex-col px-2 pb-2 gap-2">
    <span class="font-semibold text-[min(10vw,1.8rem)] capitalize">
      free plan
    </span>
    <span class="text-Light_Text_Secondary/64 dark:text-Dark_Text_Secondary/64">
      Just wanna watch some anime or read some manga without concerns about
      safety? you're in right place with not paying anything you can still have
      your safety and privacy in check!
    </span>
  </p>

  <Horizontal />
  <div class="flex flex-col items-start justify-center w-full h-fit gap-4">
    <ADS>
      <span class="material-symbols-rounded text-red-400">close</span>
    </ADS>

    <NonPersonalizedADS>
      <span class="material-symbols-rounded text-green-300">check</span>
    </NonPersonalizedADS>

    <FasterDownloads>
      <span class="material-symbols-rounded text-red-400">close</span>
    </FasterDownloads>

    <FasterUploads>
      <span class="material-symbols-rounded text-red-400">close</span>
    </FasterUploads>

    <FastConnection>
      <span class="material-symbols-rounded text-red-400">close</span>
    </FastConnection>

    <CloudStroage>
      <p class="w-fit font-normal text-nowrap">1 GB</p>
    </CloudStroage>

    <Customization>
      <span class="material-symbols-rounded text-red-400">close</span>
    </Customization>

    <Encryption>
      <span class="material-symbols-rounded text-green-300">check</span>
    </Encryption>

    <PrioritySupport>
      <span class="material-symbols-rounded text-red-400">close</span>
    </PrioritySupport>

    <EarlyAccess>
      <span class="material-symbols-rounded text-red-400">close</span>
    </EarlyAccess>
  </div>

  <Horizontal />

  <div class="flex flex-col w-full h-fit items-start justify-start">
    <div
      class="flex flex-row items-center justify-start w-full h-fit gap-4 px-2 mb-2 capitalize"
    >
      <p
        class="text-Light_Text_Secondary/64 dark:text-Dark_Text_Secondary/64 font-semibold text-[min(7vw,1.2rem)]"
      >
        free
      </p>
    </div>

    <button
      class="flex flex-row items-center justify-center w-full h-fit rounded-xl p-4 gap-4 bg-Light_Tertiary/50 dark:bg-Dark_Tertiary/50 border border-Light_Border_Primary/50 dark:border-Dark_Border_Primary/50 font-semibold text-Light_Text_Secondary/64 dark:text-Dark_Text_Secondary/64"
    >
      <p>Owned</p>
    </button>
  </div>
</div>
