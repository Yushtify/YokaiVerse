---
import FreeTier from "./susbcription_Cards/freeTier.astro";
import AzureTier from "./susbcription_Cards/azureTier.astro";
import SupporterTier from "./susbcription_Cards/supporterTier.astro";
import LifeTimeAzureTier from "./susbcription_Cards/lifeTimeAzureTier.astro";
---

<div
  class="relative flex flex-col items-start justify-center gap-4 w-full h-fit text-left text-[min(4vw,1rem)] text-Light_Text_Primary dark:text-Dark_Text_Primary"
>
  <!-- Grid -->
  <div
    class="flex flex-col md:grid lg:grid-cols-2 xl:grid-cols-4 items-start justify-center w-full h-fit p-4 mt-8 gap-4 rounded-xl"
  >
    <FreeTier />
    <AzureTier />
    <LifeTimeAzureTier />
    <SupporterTier />
  </div>
</div>
