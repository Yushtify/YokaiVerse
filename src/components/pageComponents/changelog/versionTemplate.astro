---
import GoogleMaterialSymbol from "../../custom/googleMaterial_Symbol.astro";
import VersionDetailTemplate from "./versionDetailTemplate.astro";
---

<template id="versionTemplate">
    <div
        id="version_0_0_1"
        class="group flex flex-col items-center justify-center gap-4 p-4 md:p-8 rounded-3xl w-full h-fit bg-L_Primary dark:bg-D_Primary text-[min(7vw,1rem)] text-LT_Primary dark:text-DT_Primary transition-colors duration-250 ease-in-out"
    >
        <div
            class="flex flex-col md:flex-row items-start justify-center gap-4 w-full"
        >
            <!-- Title -->
            <div class="flex flex-col items-start justify-center w-full h-fit">
                <div
                    class="flex flex-row items-end justify-start gap-2 w-full h-fit"
                >
                    <p
                        id="versionTitle"
                        class="font-semibold text-[min(7vw,1.4rem)] uppercase"
                    >
                        v0.0.1
                    </p>
                    <p
                        id="versionDate"
                        class="text-[min(7vw,0.8rem)] text-LT_Tertiary dark:text-DT_Tertiary capitalize"
                    >
                        December 1th 2025
                    </p>
                </div>
                <p
                    id="versionDescription"
                    class="text-[min(7vw,1rem)] text-LT_Secondary dark:text-DT_Secondary line-clamp-2"
                >
                    First release of the YokaiVerse, does has little amount of
                    features.
                </p>
            </div>

            <a
                id="versionDetails_Link"
                href=""
                class="group flex flex-row items-center justify-center gap-4 p-4 rounded-3xl w-fit h-fit bg-L_BG dark:bg-D_BG group-hover:bg-Accent border border-LB_Primary dark:border-DB_Primary transition-colors duration-250 ease-in-out capitalize cursor-pointer"
            >
                <p
                    class="font-semibold text-[min(7vw,1rem)] group-hover:text-LT_Inverted dark:group-hover:text-DT_Inverted"
                >
                    details
                </p>
                <div
                    class="flex flex-row items-center justify-center p-2 aspect-square rounded-3xl bg-L_Secondary dark:bg-D_Secondary group-hover:bg-LightAccent"
                >
                    <GoogleMaterialSymbol
                        symbol="arrow_outward"
                        SVG_Style="group-hover:text-LT_Inverted dark:group-hover:text-DT_Inverted"
                    />
                </div>
            </a>
        </div>

        <div
            id="logList"
            class="flex flex-col items-start justify-center gap-4 w-full h-full"
        >
            <VersionDetailTemplate />
        </div>
    </div>
</template>
