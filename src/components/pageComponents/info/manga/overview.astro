---
import EpisodeContainerGlobal from "../../../custom/episodeContainerGlobal.astro";
import ExpandableInfoChip from "../../../custom/expandableInfoChip.astro";
import InformationBlobs from "../../../custom/public/informationBlobs.astro";
import CategoryList from "./categoryList.astro";
---

<div
    class="flex flex-col lg:flex-col items-start justify-start gap-4 w-fit h-fit"
>
    <div
        class="flex flex-col-reverse lg:flex-row items-start justify-start gap-4 w-full h-fit"
    >
        <div
            class="flex flex-col items-start justify-center gap-4 w-full h-fit py-4"
        >
            <p
                id="contentTitle"
                class="w-full h-fit font-bold text-[min(6vw,3.4rem)] text-LT_Primary dark:text-DT_Primary capitalize"
            >
                content title
            </p>

            <div
                class="flex flex-col lg:flex-row items-start justify-center w-full h-fit gap-4"
            >
                <ExpandableInfoChip
                    givenID="contentDesc"
                    givenTextID="contentDescText"
                    givenTitle="Description"
                    titleData="global.variable.desc"
                    givenDesc="Lorem, ipsum dolor sit amet consectetur adipisicing elit. Unde odit temporibus quas ipsa, cupiditate sunt officiis quam nulla? Rem assumenda ad, quia obcaecati itaque accusantium fuga placeat minus ipsam soluta. Lorem, ipsum dolor sit amet consectetur adipisicing elit. Unde odit temporibus quas ipsa, cupiditate sunt officiis quam nulla? Rem assumenda ad, quia obcaecati itaque accusantium fuga placeat minus ipsam soluta. Lorem, ipsum dolor sit amet consectetur adipisicing elit. Unde odit temporibus quas ipsa, cupiditate sunt officiis quam nulla? Rem assumenda ad, quia obcaecati itaque accusantium fuga placeat minus ipsam soluta."
                />
                <div
                    class="flex flex-row flex-wrap items-start justify-start gap-2 w-full xl:w-[155%] h-fit"
                >
                    <InformationBlobs
                        givenID="contentViews"
                        givenTextID="contentViews_Text"
                        givenTitle="content views"
                        titleData="info.overview.contentViews.title"
                        givenSymbol="visibility"
                        givenInformation="Loading Data..."
                        informationData=""
                    />
                    <InformationBlobs
                        givenID="contentRating"
                        givenTextID="contentRating_Text"
                        givenTitle="content rating"
                        titleData="info.overview.contentRating.title"
                        givenSymbol="star"
                        givenInformation="Loading Data..."
                        informationData=""
                    />
                    <InformationBlobs
                        givenID="contentAuthorStudio"
                        givenTextID="contentAuthorStudio_Text"
                        givenSymbol="copyright"
                        givenTitle="Author Studio"
                        titleData="info.overview.authorStudio.title"
                        givenInformation="Loading Data..."
                        informationData=""
                    />
                    <InformationBlobs
                        givenID="releaseDate"
                        givenTextID="releaseDate_Text"
                        givenTitle="release date"
                        titleData="info.overview.releaseDate.title"
                        givenSymbol="date_range"
                        givenInformation="Loading Data..."
                        informationData=""
                    />
                    <InformationBlobs
                        givenID="contentAgeRating"
                        givenTextID="contentAgeRating_Text"
                        givenTitle="content age rating"
                        titleData="info.overview.contentAgeRating.title"
                        givenSymbol="shield_question"
                        givenInformation="Loading Data..."
                        informationData=""
                    />
                    <InformationBlobs
                        givenID="contentChapters"
                        givenTextID="contentChapters_Text"
                        givenSymbol="movie_info"
                        givenTitle="chapters"
                        titleData="info.overview.contentChapters.title"
                        givenInformation="Loading Data..."
                        informationData=""
                    />
                </div>
            </div>
            <CategoryList />
        </div>
    </div>
    <EpisodeContainerGlobal givenID="manga" givenWidth="w-full" />
</div>
