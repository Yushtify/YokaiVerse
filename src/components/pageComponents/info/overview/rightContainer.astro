---
import VideoButton from "../../../custom/buttons/gridEpisodeButton.astro";
---

<div
  class="flex flex-col items-start justify-center gap-2 w-full lg:max-w-[35%] h-fit"
>
  <p
    class="mx-4 font-semibold text-Light_Text_Primary dark:text-Dark_Text_Primary text-[min(7vw,2rem)]"
  >
    Start
  </p>
  <div
    id="firstEpisodeContainer"
    class="flex flex-col items-start justify-start w-full h-fit gap-4"
  >
    <VideoButton
      givenVideoID="murderDrones"
      VideoRootSRC="/src/assets/animes/murderDrones/ep_1"
      givenVideoTitle="Murder Drones - Episode 1: Plot"
      givenVideoDesc="Desc of the specific Episode will appear at this section only three maximum lines"
    />
  </div>
</div>
