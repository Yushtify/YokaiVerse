---
import InformationContainer from "./informationContainer/informationContainer.astro";
---

<div
  class="relative flex flex-col items-center justify-start w-full h-auto min-h-[300px] lg:aspect-21/9 bg-Light_Secondary dark:bg-Dark_Secondary text-[min(7vw,1rem)] text-Light_Text_Primary dark:text-Dark_Text_Primary overflow-hidden flex-shrink-0"
>
  <img
    id="BannerImage"
    class="absolute inset-0 w-full h-full object-cover z-0"
    src=""
    alt="BANNER"
  />

  <div
    class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-1"
  >
  </div>

  <div class="relative z-10 w-full h-full">
    <InformationContainer />
  </div>
</div>
