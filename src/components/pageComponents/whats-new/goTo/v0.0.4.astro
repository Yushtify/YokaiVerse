---
const Version = "v0.0.4";
const HREF = "#" + Version;
const Desc = "Patch update";
---

<div
  class="flex flex-col items-center justify-between gap-2 p-2 w-full h-fit bg-Light_Secondary dark:bg-Dark_Secondary"
>
  <div
    class="flex flex-row items-center justify-between gap-2 pl-2 w-full h-fit"
  >
    <p class="font-semibold text-[min(7vw,1.2rem)]">{Version}</p>
    <a
      onclick="fadeDIV('goTo_DIV', true, 150)"
      href={HREF}
      class="flex flex-row items-center justify-center aspect-square rounded-xl gap-2 p-2 w-fit h-fit hover:text-Accent"
    >
      <span id="googleSymbol" class="material-symbols-rounded">search</span>
    </a>
  </div>
  <p
    class="ml-2 w-full text-left text-Light_Text_Secondary/64 dark:text-Dark_Text_Secondary/64"
  >
    {Desc}
  </p>
</div>
