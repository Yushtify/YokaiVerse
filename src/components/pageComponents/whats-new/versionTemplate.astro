---
import GoogleMaterialSymbol from "../../custom/googleMaterial_Symbol.astro";
import VersionDetailTemplate from "./versionDetailTemplate.astro";
---

<template id="versionTemplate">
  <div
    id="version_0_0_1"
    class="group flex flex-col items-center justify-center gap-4 p-4 md:p-8 rounded-xl w-full h-fit bg-Light_Secondary dark:bg-Dark_Secondary hover:bg-Light_Secondary_Hover dark:hover:bg-Dark_Secondary_Hover border border-Light_Border_Primary dark:border-Dark_Border_Primary text-[min(7vw,1rem)] text-Light_Text_Primary dark:text-Dark_Text_Primary transition-colors duration-250 ease-in-out"
  >
    <div
      class="flex flex-col md:flex-row items-start justify-center gap-4 w-full"
    >
      <!-- Title -->
      <div class="flex flex-col items-start justify-center w-full h-fit">
        <div class="flex flex-row items-end justify-start gap-2 w-full h-fit">
          <p
            id="versionTitle"
            class="font-semibold text-[min(7vw,1.4rem)] uppercase"
          >
            v0.0.1
          </p>
          <p
            id="versionDate"
            class="text-[min(7vw,0.8rem)] text-Light_Text_Tertiary dark:text-Dark_Text_Tertiary capitalize"
          >
            December 1th 2025
          </p>
        </div>
        <p
          id="versionDescription"
          class="text-[min(7vw,1rem)] text-Light_Text_Secondary dark:text-Dark_Text_Secondary line-clamp-2"
        >
          First release of the YokaiVerse, does has little amount of features.
        </p>
      </div>

      <button
        class="flex flec-row items-center justify-center gap-2 p-4 rounded-xl w-fit h-fit bg-Light_Primary dark:bg-Dark_Primary group-hover:bg-Accent border border-Light_Border_Primary dark:border-Dark_Border_Primary group-hover:border-Light_Border_Inverted group-hover:dark:border-Dark_Border_Inverted group-hover:font-semibold shadow-2xl shadow-transparent group-hover:shadow-Accent/32 transition-colors duration-250 ease-in-out capitalize cursor-pointer"
      >
        <p class="text-[min(7vw,0.8rem)] text-nowrap">version details</p>
        <GoogleMaterialSymbol SVG_Name="chevron_right" />
      </button>
    </div>

    <div
      id="logList"
      class="flex flex-col items-start justify-center gap-4 p-6 rounded-xl w-full h-full bg-Light_Primary dark:bg-Dark_Primary font-Mono"
    >
      <VersionDetailTemplate />
    </div>
  </div>
</template>
