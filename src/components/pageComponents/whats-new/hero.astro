---
import GoogleMaterialSymbol from "../../custom/googleMaterial_Symbol.astro";
import HeroTemplate from "../../custom/heroTemplate.astro";
import Vertical from "../../seperators/vertical.astro";

const Latestver = "v0.1.0"; // latest build version
const CodeCommit = "294bd4d"; // latest commit
const CommitDate = "Mar 02, 2026"; // To specify the date to user so they don't need to go to Github for to check i
// code link down below for lates commit
const CodeLink =
  "https://github.com/Yushtify/YokaiVerse/commit/294bd4d0af0c341a5ffb8b5105f5abd61ca5ea1b";
---

<HeroTemplate
  givenGoogleSymbol="news"
  givenTitle="Release Logs"
  givenDesc="The recent drops of Yokaiverse is in 'Development' so anything that have been changed/added may broke the product or user experience, be patient as we try to do our best to make this platform better and safer for you. Thank you for your support and patience on us."
>
  <div
    class="flex flex-col xl:flex-row items-center justify-start w-full h-fit gap-4 mt-4 py-4 text-[min(7vw,1rem)] text-Light_Text_Primary dark:text-Dark_Text_Primary"
  >
    <a
      href="#version_0_0_1"
      class="flex flex-row-reverse xl:flex-row items-center justify-between xl:justify-center min-w-48 w-full xl:w-fit h-fit p-4 rounded-xl gap-2 bg-Light_Secondary dark:bg-Dark_Secondary hover:bg-Light_Border_Primary hover:dark:bg-Dark_Border_Primary border border-Light_Border_Primary dark:border-Dark_Border_Primary hover:border-transparent outline-0 hover:outline-1 hover:outline-offset-2 outline-Light_Border_Primary dark:outline-Dark_Border_Primary font-medium text-Light_Text_Secondary dark:text-Dark_Text_Secondary hover:text-Accent capitalize transition-colors duration-300 ease-in-out"
    >
      <GoogleMaterialSymbol
        SVG_Name="find_in_page"
        SvgSize="!text-[min(7vw,1.5rem)]"
      />
      <p>first release</p>
    </a>

    <!-- To find a release -->
    <button
      onclick="fadeDIV('goTo_DIV', true, 150)"
      class="flex flex-row-reverse xl:flex-row items-center justify-between xl:justify-center min-w-48 w-full xl:w-fit h-fit p-4 rounded-xl gap-2 bg-Light_Secondary dark:bg-Dark_Secondary hover:bg-Light_Border_Primary hover:dark:bg-Dark_Border_Primary border border-Light_Border_Primary dark:border-Dark_Border_Primary hover:border-transparent outline-0 hover:outline-1 hover:outline-offset-2 outline-Light_Border_Primary dark:outline-Dark_Border_Primary font-medium text-Light_Text_Secondary dark:text-Dark_Text_Secondary hover:text-Accent capitalize transition-colors duration-300 ease-in-out cursor-pointer"
    >
      <GoogleMaterialSymbol
        SVG_Name="location_on"
        SvgSize="!text-[min(7vw,1.5rem)]"
      />
      <p>go to</p>
    </button>

    <div class="hidden xl:flex w-fit h-full">
      <Vertical />
    </div>

    <!-- Stats -->
    <div
      class="flex flex-row items-center justify-start w-full xl:w-fit h-fit p-2 rounded-xl gap-2 font-medium text-Light_Text_Secondary dark:text-Dark_Text_Secondary capitalize"
    >
      <GoogleMaterialSymbol
        SVG_Name="deployed_code_history"
        SvgSize="!text-[min(7vw,1.5rem)]"
        isFilled={true}
      />
      <p id="UpdateCounter">update counter</p>
    </div>

    <div
      class="flex flex-row items-center justify-start w-full xl:w-fit min-w-28 h-fit p-2 rounded-xl gap-2 font-medium text-Light_Text_Secondary dark:text-Dark_Text_Secondary capitalize"
    >
      <GoogleMaterialSymbol
        SVG_Name="calendar_clock"
        SvgSize="!text-[min(7vw,1.5rem)]"
        isFilled={true}
      />
      <p>{CommitDate}</p>
    </div>

    <div
      class="flex flex-row items-center justify-start w-full xl:w-fit min-w-28 h-fit p-2 rounded-xl gap-2 font-medium text-Light_Text_Secondary dark:text-Dark_Text_Secondary capitalize"
    >
      <GoogleMaterialSymbol
        SVG_Name="commit"
        SvgSize="!text-[min(7vw,1.5rem)]"
        isFilled={true}
      />
      <a
        href={CodeLink}
        class="hover:!text-Accent hover:underline hover:underline-offset-4 hover:decoration-wavy transition-colors duration-300 ease-in-out"
      >
        {CodeCommit}
      </a>
    </div>
  </div>
</HeroTemplate>
