---
const UpdateVer = "v0.0.2";
const UpdateCommit = "9994037"; // latest commit
const UpdateDate = "Nov 11, 2025"; // To specify the date to user so they don't need to go to Github for to check i
// code link down below for lates commit
const UpdateLink =
  "https://github.com/Yushtify/YokaiVerse/commit/9994037cf2367e8c501ea549f48b4fb44fd3033d";
// github Update log link
const UpdateLogLink =
  "https://github.com/Yushtify/YokaiVerse/releases/tag/" + UpdateVer;

const StateParagraphs = {
  Added: `<p class="uppercase font-semibold text-green-300 text-nowrap">added</p>`,
  Removed: `<p class="uppercase font-semibold text-red-400 text-nowrap">removed</p>`,
  Changed: `<p class="uppercase font-semibold text-orange-300 text-nowrap">changed</p>`,
  Misc: `<p class="uppercase font-semibold text-nowrap">added misc</p>`,
};

const DivRelID = UpdateVer;

import Container from "./container.astro";
---

<Container
  givenDivRelID={DivRelID}
  givenUpdateVer={UpdateVer}
  givenUpdateLogLink={UpdateLogLink}
  givenUpdateLink={UpdateLink}
  givenUpdateCommit={UpdateCommit}
  givenUpdateDate={UpdateDate}
>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div> watch page
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div> marketplace page
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div> update log page
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div> automatic collapsing for updates
    expect latest release.
  </div>

  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Changed}></div>
    home page have been changed
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Changed}></div>
    changed folder layout for "/video"
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Changed}></div>
    some layouts to make them more server sided changes via Astro.
  </div>
</Container>
