---
const UpdateVer = "v0.0.4";
const UpdateCommit = "294bd4d"; // latest commit
const UpdateDate = "Dec 28, 2025"; // To specify the date to user so they don't need to go to Github for to check i
// code link down below for lates commit
const UpdateLink =
  "https://github.com/Yushtify/YokaiVerse/commit/294bd4d0af0c341a5ffb8b5105f5abd61ca5ea1b";
// github Update log link
const UpdateLogLink =
  "https://github.com/Yushtify/YokaiVerse/releases/tag/" + UpdateVer;

const StateParagraphs = {
  Added: `<p class="uppercase font-semibold text-green-300 text-nowrap">added</p>`,
  Removed: `<p class="uppercase font-semibold text-red-400 text-nowrap">removed</p>`,
  Changed: `<p class="uppercase font-semibold text-orange-300 text-nowrap">changed</p>`,
  Known_Bug: `<p class="uppercase text-red-600 font-semibold text-nowrap">known bug</p>`,
  Misc: `<p class="uppercase font-semibold text-nowrap">added misc</p>`,
};

const DivRelID = UpdateVer;

import Container from "./container.astro";
---

<Container
  givenDivRelID={DivRelID}
  givenUpdateVer={UpdateVer}
  givenUpdateLogLink={UpdateLogLink}
  givenUpdateLink={UpdateLink}
  givenUpdateCommit={UpdateCommit}
  givenUpdateDate={UpdateDate}
>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div>
    new icons for landing "what we offer" section.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div>
    settings Page.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div>
    title and uploader for the video player.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div>
    nsfw filter (hard coded) for some videos only thumbnails.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div>
    fullscreen mode for video player.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div>
    feedbacks to the controls of the custom video player.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div>
    time stamp for the pre of the videos.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div>
    more support for the mobile.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div>
    home page moved to discover.
  </div>

  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Changed}></div>
    All Fontawesome 7.0 Free fonts, now Google material icons.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Changed}></div>
    some of the slogans for landing page.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Changed}></div>
    some id names for the video player.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Changed}></div>
    most of the repeating ui to companents.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Changed}></div>
    landing page and it's companents, to make them more UX friendly.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Changed}></div>
    folder layout for the video's their roots sent to code via a json file in thr
    "/public"
  </div>

  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Removed}></div>
    video's from landing "what we offer" seciton.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Removed}></div>
    homepage.
  </div>

  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Known_Bug}></div>
    The automatic collapsing at the Update log / "whats-new" page is broken.
  </div>
</Container>
