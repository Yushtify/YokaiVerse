---
const UpdateVer = "v0.0.1";
const UpdateCommit = "c806167"; // latest commit
const UpdateDate = "Nov 2, 2025"; // To specify the date to user so they don't need to go to Github for to check i
// code link down below for lates commit
const UpdateLink =
  "https://github.com/Yushtify/YokaiVerse/commit/c80616782e5d3e3d523ebc0950d2b9c07e1be226";
// github Update log link
const UpdateLogLink =
  "https://github.com/Yushtify/YokaiVerse/releases/tag/" + UpdateVer;

const StateParagraphs = {
  Added: `<p class="uppercase font-semibold text-green-300 text-nowrap">added</p>`,
  Removed: `<p class="uppercase font-semibold text-red-400 text-nowrap">removed</p>`,
  Changed: `<p class="uppercase font-semibold text-orange-300 text-nowrap">changed</p>`,
  Misc: `<p class="uppercase font-semibold text-nowrap">added misc</p>`,
};

const DivRelID = UpdateVer;

import Container from "./container.astro";
---

<Container
  givenDivRelID={DivRelID}
  givenUpdateVer={UpdateVer}
  givenUpdateLogLink={UpdateLogLink}
  givenUpdateLink={UpdateLink}
  givenUpdateCommit={UpdateCommit}
  givenUpdateDate={UpdateDate}
>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div> 404 page
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div> landing page
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div> home page
  </div>

  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Misc}></div> Landing's slogan with easter eggs,
    for more information visit the commit log and update log on github.
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Misc}></div> konami code secret
  </div>
</Container>
