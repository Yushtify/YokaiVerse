---
const UpdateVer = "v0.0.3";
const UpdateCommit = "294bd4d"; // latest commit
const UpdateDate = "Nov 22, 2025"; // To specify the date to user so they don't need to go to Github for to check i
// code link down below for lates commit
const UpdateLink =
  "https://github.com/Yushtify/YokaiVerse/commit/294bd4d0af0c341a5ffb8b5105f5abd61ca5ea1b";
// github Update log link
const UpdateLogLink =
  "https://github.com/Yushtify/YokaiVerse/releases/tag/" + UpdateVer;

const StateParagraphs = {
  Added: `<p class="uppercase font-semibold text-green-300 text-nowrap">added</p>`,
  Removed: `<p class="uppercase font-semibold text-red-400 text-nowrap">removed</p>`,
  Changed: `<p class="uppercase font-semibold text-orange-300 text-nowrap">changed</p>`,
  Misc: `<p class="uppercase font-semibold text-nowrap">added misc</p>`,
};

const DivRelID = UpdateVer;

import Container from "./container.astro";
---

<Container
  givenDivRelID={DivRelID}
  givenUpdateVer={UpdateVer}
  givenUpdateLogLink={UpdateLogLink}
  givenUpdateLink={UpdateLink}
  givenUpdateCommit={UpdateCommit}
  givenUpdateDate={UpdateDate}
>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div>
    3 new videos to collection
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div>
    closing the video option onto custom video player
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div>
    forwarding (15s) and backwarding (5s) the video option onto custom video player
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Added}></div>
    debug mode to the custom video player
  </div>

  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Changed}></div>
    video player made the buttons better added a skip video button, added secondary
    pause button beside the time stamp
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Changed}></div>
    version number size on the "What's new" (Release Log) page
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Changed}></div>
    white theme colorss
  </div>

  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Removed}></div>
    middle control buttons from custom video player
  </div>
  <div class="flex flex-row items-start justify-start gap-2">
    <div set:html={StateParagraphs.Removed}></div>
    skip video option from time stamp bar on the custom video player
  </div>
</Container>
