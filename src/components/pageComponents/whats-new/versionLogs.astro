---
import VersionTemplate from "./versionTemplate.astro";
---

<div
  id="versionLogContainer"
  class="flex flex-col items-center jusitfy-start gap-8 w-full h-fit p-2 md:p-4 lg:p-8 xl:p-12 xl:px-48"
>
  <VersionTemplate />
</div>

<script>
  // English comments as requested
  // Dynamic version crawler with LoadingManager integration
  async function loadAllVersions() {
    const container = document.getElementById("versionLogContainer");
    const counterDisplay = document.getElementById("UpdateCounter");
    if (!container) return;

    LoadingManager.show("Fetching Version Logs...");

    let major = 0;
    let minor = 0;
    let patch = 0;
    let active = true;
    let anyVersionFound = false;
    let versionCount = 0; // Initialize counter

    const statusColors: Record<string, string> = {
      Added: "text-green-300",
      Removed: "text-red-400",
      Fixed: "text-orange-200",
      Changed: "text-orange-300",
      Experimental: "text-Accent",
      Misc: "text-gray-100",
      Known_Bug: "text-red-600",
    };

    try {
      while (active) {
        const fileName = `v${major}_${minor}_${patch}`;
        const filePath = `/src/components/pageComponents/whats-new/versions/${fileName}.json`;

        const response = await fetch(filePath);

        if (response.ok) {
          const data = await response.json();
          renderVersionCard(data, container, statusColors);

          anyVersionFound = true;
          versionCount++; // Increment total found versions
          patch++;
        } else {
          if (patch > 0) {
            minor++;
            patch = 0;
          } else if (minor > 0) {
            major++;
            minor = 0;
            patch = 0;
          } else {
            if (major === 0 && minor === 0 && patch === 0) {
              minor = 1;
            } else {
              active = false;
            }
          }
        }

        if (major > 10) active = false;
      }

      // Post-crawl UI Updates
      if (!anyVersionFound) {
        LoadingManager.setError("No version logs were found.");
      } else {
        // Update the counter HTML with the total count
        if (counterDisplay) {
          counterDisplay.innerHTML = versionCount.toString() + " updates";
        }
        LoadingManager.hide();
      }
    } catch (error: any) {
      console.error("Crawl Error:", error);
      LoadingManager.setError(
        error.message || "Failed to load version history.",
      );
    }
  }

  /**
   * Helper: Renders version cards from template
   * English comments as requested.
   */
  function renderVersionCard(data: any, container: HTMLElement, colors: any) {
    console.log(`Starting render for: ${data.version}`);

    const mainTemplate = document.getElementById(
      "versionTemplate",
    ) as HTMLTemplateElement;
    if (!mainTemplate) return;

    const cardClone = mainTemplate.content.cloneNode(true) as HTMLElement;

    cardClone.querySelector("#versionTitle")!.textContent = data.version;
    cardClone.querySelector("#versionDate")!.textContent = data.date;
    cardClone.querySelector("#versionDescription")!.textContent =
      data.description;

    const detailTemplate = cardClone.querySelector(
      "#versionDetail_Template",
    ) as HTMLTemplateElement;
    const logList = cardClone.querySelector("#logList")!;

    if (detailTemplate && logList) {
      logList.innerHTML = "";

      data.logs.forEach((log: any) => {
        const detailClone = detailTemplate.content.cloneNode(
          true,
        ) as HTMLElement;

        const titleWrapper = detailClone.querySelector("#versionDetail_Title");
        const descElement = detailClone.querySelector("#versionDetail_Desc");

        if (titleWrapper) {
          const label =
            log.type === "Misc" ? "ADDED MISC" : log.type.replace("_", " ");
          const colorClass = colors[log.type] || "text-white";
          titleWrapper.innerHTML = `<p class="uppercase font-semibold ${colorClass} text-nowrap">${label}</p>`;
        }

        if (descElement) {
          descElement.textContent = log.desc;
          descElement.className =
            "text-Light_Text_Primary dark:text-Dark_Text_Primary";
        }

        logList.appendChild(detailClone);
      });
    }

    container.prepend(cardClone);
    console.log(`Successfully rendered: ${data.version}`);
  }

  document.addEventListener("DOMContentLoaded", loadAllVersions);
</script>
