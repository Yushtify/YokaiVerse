---
import Image from "astro/components/Image.astro";
import CoverIMG from "/src/assets/videos/bfaKazuma/cover.webp";
// ensure it's a plain string you can inject into attributes/onclick
const VideoSRCString = "/src/assets/videos/bfaKazuma";
const VideoName = "bfaKazumaThumbnail";
---

<button
  class="flex flex-col items-start justify-start snap-start w-full h-fit rounded-xl gap-4 p-2 hover:bg-Light_Secondary_Hover dark:hover:bg-Dark_Secondary_Hover border border-transparent hover:border-Light_Border_Secondary dark:hover:border-Dark_Border_Secondary hover:shadow-2xl hover:shadow-Light_Secondary_Hover dark:hover:shadow-Dark_Secondary_Hover hover:scale-102 transition-all duration-300 ease-in-out cursor-pointer"
  onclick={`enableCustomVideoPlayer('${VideoSRCString}',  0)`}
>
  <Image
    src={CoverIMG}
    id={VideoName}
    alt="COVER"
    class="rounded-xl aspect-video w-full h-auto blur-lg"
  />
  <div class="flex flex-col items-start justify-start px-2 pb-2 text-left">
    <div class="flex flex-row items-start justify-start gap-2">
      <img
        src="/src/assets/videos/bfaKazuma/uploader.webp"
        alt="UPLOADER"
        class="w-12 aspect-square rounded-xl"
      />
      <div class="flex flex-col w-full h-full">
        <p class="font-medium text-[min(10vw,1.15rem)] capitalize line-clamp-1">
          BFA Kazuma - English Sub -18
        </p>
        <p
          class="text-[min(6vw,0.9rem)] text-Light_Text_Secondary/64 dark:text-Dark_Text_Secondary/64 line-clamp-1"
        >
          Uploaded by @Yushtify
        </p>
        <div
          class="flex flex-row items-center justify-start gap-1 w-full h-fit mt-2 font-mono text-[min(5vw,0.75rem)] text-Light_Text_Tertiary/45 dark:text-Dark_Text_Tertiary/45"
        >
          <p>115M views</p>
          <p>•</p>
          <p>Dec 24, 2025</p>
        </div>
      </div>
    </div>
  </div>
</button>
