---
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";

interface Props {
    givenState: boolean;
    givenID: string;
    groupName: string;
    canDisabled?: boolean;
}

const { givenState, givenID, groupName, canDisabled = true } = Astro.props;

// Base look = deactive state, always applied.
const baseClass =
    "group relative flex flex-row items-start justify-center p-2 w-full h-auto gap-2 rounded-3xl bg-L_Primary dark:bg-D_Primary text-LT_Primary dark:text-DT_Primary hover:-translate-y-2 hover:scale-102 shadow-2xl shadow-transparent md:hover:shadow-LB_Primary/64 md:dark:hover:shadow-DB_Primary/64 transition-all duration-200 ease-in-out cursor-pointer";

// Active-state overrides only — the two classlists only actually
// differ on background + hover shadow color, everything else is shared.
const activeOverrideClass =
    "bg-Accent! hover:bg-Highlight! text-LT_Inverted! dark:text-DT_Inverted! hover:shadow-Accent/48!";
---

<button
    type="button"
    id={givenID}
    class={baseClass}
    data-radgroup={groupName}
    data-radstate={givenState ? "true" : "false"}
    data-radActive={activeOverrideClass}
    data-candisabled={canDisabled ? "true" : "false"}
>
    <div
        class="relative flex flex-col items-start justify-start w-fit h-fit rounded-3xl rounded-r-xl overflow-hidden"
    >
        <img
            id="seasonCover"
            src="../../../assets/animes/Zom100/season_1/cover.webp"
            alt="SEASON_COVER"
            class="w-32 md:w-48 aspect-9/14"
        />
        <p
            class="absolute bottom-2 right-2 flex flex-row items-center justify-center gap-2 min-w-fit w-fit rounded-3xl p-2 px-4 bg-L_BG dark:bg-D_BG font-bold text-[min(6vw,0.8rem)] text-left capitalize line-clamp-1 transition-colors duration-200 ease-in-out"
            data-radActive="bg-LightAccent!"
        >
            <GoogleMaterialSymbol
                symbol="star"
                SvgSize="!text-[min(6vw,1rem)]"
                isFilled={true}
            />
            <span id="seasonRating">0</span>
        </p>
    </div>
    <div
        class="flex flex-col items-start justify-start py-2 pr-2 gap-2 w-full h-full text-left"
    >
        <div
            class="flex flex-row items-center justify-start gap-2 w-full h-full text-left"
        >
            <p
                id="seasonTitle"
                class="w-full h-fit text-[min(6vw,1.2rem)] line-clamp-1 group-hover:line-clamp-3 font-semibold"
            >
                Unamed Season
            </p>
            <p
                class="flex flex-row items-center justify-center gap-1 min-w-fit w-fit rounded-3xl p-2 px-4 bg-L_BG dark:bg-D_BG font-bold text-[min(6vw,0.8rem)] text-left capitalize line-clamp-1 transition-colors duration-200 ease-in-out"
                data-radActive="bg-LightAccent!"
            >
                <span data-i18n="global.variable.season">season</span>
                <span id="seasonNumber"></span>
            </p>
        </div>
        <p
            id="seasonDesc"
            class="w-full h-fit text-left text-[min(6vw,1rem)] line-clamp-5"
        >
            No Description Available
        </p>
    </div>
</button>
