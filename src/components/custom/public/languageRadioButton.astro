---
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";

interface Props {
    givenLocationFrom?: "horizontal" | "vertical";
    givenLocation?: "start" | "center" | "end";
    givenTitle: string;
    givenState: boolean;
    givenID: string;
    groupName: string;
    canDisabled?: boolean;
    dataLang: string;
    givenSymbol?: string;
}

const {
    givenLocationFrom,
    givenLocation,
    givenTitle,
    givenState,
    givenID,
    groupName,
    canDisabled = true,
    dataLang,
    givenSymbol,
} = Astro.props;

// validate button rounded
const borderRadiusMap = {
    horizontal: {
        start: "rounded-xl rounded-l-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-r-3xl",
    },
    vertical: {
        start: "rounded-xl rounded-t-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-b-3xl",
    },
} as const;

const borderRadius =
    givenLocationFrom && givenLocation
        ? borderRadiusMap[givenLocationFrom][givenLocation]
        : "rounded-3xl";
const validBorderRadius = `${borderRadius} hover:rounded-3xl`;

const classMap = {
    // Base look = deactive state. This is always applied on the element.
    buttonDefClass: `${validBorderRadius} filter-btn group relative flex flex-row items-center justify-start min-w-fit w-full h-fit gap-4 p-4 pr-6 bg-L_Secondary dark:bg-D_Secondary hover:bg-Highlight text-nowrap font-semibold text-left text-[min(6vw,0.9rem)] text-LT_Primary dark:text-DT_Primary hover:text-LT_Inverted dark:hover:text-DT_Inverted overflow-hidden cursor-pointer capitalize transition-all duration-200 ease-in-out`,
    // Active-state overrides only (uses `!` so they win over baseClass
    // regardless of stylesheet order — same pattern as the icon-radio button).
    buttonActiveClass:
        "bg-Accent! hover:bg-Highlight! text-LT_Inverted! dark:text-DT_Inverted! uppercase! capitalize-none!",
    hasSymbol: givenSymbol ? "inline" : "hidden",
};
---

<button
    type="button"
    id={givenID}
    class={classMap.buttonDefClass}
    data-radgroup={groupName}
    data-radstate={givenState ? "true" : "false"}
    data-radActive={classMap.buttonActiveClass}
    data-candisabled={canDisabled ? "true" : "false"}
    data-lang={dataLang}
>
    <div
        class="flex flex-row items-center justify-center w-fit h-fit rounded-3xl p-2 bg-L_Primary dark:bg-D_Primary group-hover:bg-L_Primary_Hover dark:group-hover:bg-D_Primary_Hover text-LT_Secondary dark:text-DT_Secondary"
        data-radActive="bg-LightAccent! text-LT_Inverted! dark:text-DT_Inverted!"
    >
        <GoogleMaterialSymbol
            symbol={givenSymbol}
            SVG_Style={classMap.hasSymbol}
            SymbolSize="text-[min(6vw,1.5rem)]"
            isFilled={true}
        />
    </div>
    <p id="title">
        {givenTitle}
    </p>
</button>
