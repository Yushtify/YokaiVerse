<template id="tooltipTemplate">
    <div
        id="tooltip"
        class="absolute top-0 left-0 flex flex-col rounded-3xl gap-1 px-4 p-4 w-fit max-w-86 h-fit bg-L_Primary dark:bg-D_Primary border-2 border-LB_Primary dark:border-DB_Primary text-[min(6vw,0.9rem)] z-999"
    >
        <p
            id="tooltipTitle"
            data-i18n="tooltip.defaultTitle"
            class="font-semibold text-[min(6vw,0.8rem)] text-LT_Primary dark:text-DT_Primary uppercase"
        >
            Title for
        </p>
        <p
            id="tooltipDescription"
            data-i18n="tooltip.defaultDesc"
            class="text-LT_Secondary dark:text-DT_Secondary"
        >
            Desc for
        </p>
    </div>
</template>
