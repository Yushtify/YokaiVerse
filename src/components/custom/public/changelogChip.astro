---
interface Props {
    givenID?: string;
    givenType?:
        | "Added"
        | "Changed"
        | "Fixed"
        | "Removed"
        | "Experimental"
        | "Misc"
        | "Known_Bug"
        | "Deprecated"
        | "Security"
        | "Performance"
        | "Breaking"
        | "Reverted";
    givenData?: string;
}

const { givenID = "", givenType, givenData = "" } = Astro.props;

const typeConfig: Record<string, { bg: string; text: string; label: string }> =
    {
        Added: {
            bg: "bg-green-500/20",
            text: "text-green-400",
            label: "Added",
        },
        Changed: {
            bg: "bg-amber-500/20",
            text: "text-amber-400",
            label: "Changed",
        },
        Fixed: {
            bg: "bg-sky-500/20",
            text: "text-sky-400",
            label: "Fixed",
        },
        Removed: {
            bg: "bg-red-500/20",
            text: "text-red-400",
            label: "Removed",
        },
        Experimental: {
            bg: "bg-Accent/10",
            text: "text-Accent",
            label: "Experimental",
        },
        Misc: {
            bg: "bg-gray-500/20",
            text: "text-gray-400",
            label: "Misc",
        },
        Known_Bug: {
            bg: "bg-rose-700/20",
            text: "text-rose-500",
            label: "Known Bug",
        },
        Deprecated: {
            bg: "bg-orange-500/20",
            text: "text-orange-400",
            label: "Deprecated",
        },
        Security: {
            bg: "bg-teal-500/20",
            text: "text-teal-400",
            label: "Security",
        },
        Performance: {
            bg: "bg-cyan-500/20",
            text: "text-cyan-400",
            label: "Performance",
        },
        Breaking: {
            bg: "bg-fuchsia-600/20",
            text: "text-fuchsia-500",
            label: "Breaking",
        },
        Reverted: {
            bg: "bg-slate-500/20",
            text: "text-slate-400",
            label: "Reverted",
        },
    };

const config = givenType ? typeConfig[givenType] : null;
const colorClasses = config ? `${config.bg} ${config.text}` : "";
const label = config ? config.label : "";
const chipTxtID = givenID + "_TXT";
---

<div
    id={givenID}
    data-i18n={givenData}
    class={`flex flex-row items-center justify-start gap-2 p-1 rounded-3xl w-full h-fit text-[min(6vw,0.9rem)] ${colorClasses}`}
>
    <p class="p-4 font-semibold uppercase text-wrap md:text-nowrap">
        {label}
    </p>
    <div
        class="flex flex-row items-items-center justify-start rounded-l-xl rounded-3xl p-4 px-6 w-full min-h-fit h-full bg-L_BG dark:bg-D_BG"
    >
        <slot />
    </div>
</div>
