---
import DropdownMenu from "../dropdownMenu.astro";
import LanguageRadioButton from "./languageRadioButton.astro";
---

<DropdownMenu
    givenID="languageSwitcher"
    hasDropdownArrow={true}
    hasSymbolContainer={true}
    givenSymbol="translate"
    givenTitle="Switch Language"
    givenTitleData="footer.languageSwitcher"
    bgColor="Secondary"
>
    <LanguageRadioButton
        givenLocationFrom="vertical"
        givenLocation="start"
        groupName="languageSwitch"
        givenID="automaticLanguage"
        givenState={true}
        givenSymbol="translate"
        givenTitle="Automatic"
        dataLang="auto"
    />
    <LanguageRadioButton
        givenLocationFrom="vertical"
        givenLocation="center"
        groupName="languageSwitch"
        givenID="englishLanguage"
        givenState={false}
        givenSymbol="translate"
        givenTitle="English US"
        dataLang="en_us"
    />
    <LanguageRadioButton
        givenLocationFrom="vertical"
        givenLocation="end"
        groupName="languageSwitch"
        givenID="turkishLanguage"
        givenState={false}
        givenSymbol="translate"
        givenTitle="Türkçe"
        dataLang="tr"
    />
</DropdownMenu>
