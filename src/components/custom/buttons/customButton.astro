---
interface Props {
  givenID: string;
}
const { givenID } = Astro.props;
---

<button
  id={givenID}
  class="relative flex flex-row items-center justify-start w-fit h-fit gap-2 rounded-3xl p-3 text-nowrap font-semibold text-left text-[min(6vw,0.9rem)] text-LT_Secondary dark:text-DT_Secondary transition-all duration-300 ease-in-out overflow-hidden cursor-pointer capitalize"
  onclick="switchTheFilter(this)"
>
  <slot />
</button>

<script>
  function switchTheFilter(b: HTMLButtonElement) {
    if (!b) return console.warn("Buttons doesn't exist.");

    const activeButtonClass =
      "relative flex flex-row items-center justify-start w-fit h-fit gap-2 rounded-3xl p-3 text-nowrap font-semibold text-left text-[min(6vw,0.9rem)] text-LT_Primary dark:text-DT_Primary bg-LB_Primary dark:bg-DB_Primary transition-all duration-300 ease-in-out overflow-hidden cursor-pointer uppercase";
    const deactiveButtonClass =
      "relative flex flex-row items-center justify-start w-fit h-fit gap-2 rounded-3xl p-3 text-nowrap font-semibold text-left text-[min(6vw,0.9rem)] text-LT_Secondary dark:text-DT_Secondary transition-all duration-300 ease-in-out overflow-hidden cursor-pointer capitalize";

    if (b.className === activeButtonClass) b.className = deactiveButtonClass;
    else b.className = activeButtonClass;
  }
  (window as any).switchTheFilter = switchTheFilter;
</script>
