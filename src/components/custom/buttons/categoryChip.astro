---
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";

interface Props {
    givenID: string;
    givenTextID: string;
    givenSymbol?: string;
    givenTitle: string;
}

const { givenID, givenTextID, givenSymbol, givenTitle } = Astro.props;
const displayClass = givenSymbol ? "inline-block" : "!hidden";
---

<template id={givenID}>
    <a
        rel="stylesheet"
        href={givenTitle}
        class="group flex flex-row items-center justify-center gap-2 py-2 pl-2 px-4 w-fit h-fit rounded-full bg-L_Primary dark:bg-D_Primary hover:bg-Highlight font-regular hover:font-semibold text-nowrap text-[min(6vw,0.8rem)] text-LT_Secondary dark:text-DT_Secondary hover:text-LT_Inverted dark:hover:text-DT_Inverted hover:shadow-2xl shadow-LB_Primary dark:shadow-DB_Primary hover:scale-108 hover:z-1 transition-all duration-200 ease-in-out capitalize"
    >
        <div
            class="flex flex-row items-center justify-center p-2 rounded-3xl bg-L_BG dark:bg-D_BG group-hover:bg-LightAccent transition-colors duration-200 ease-in-out"
        >
            <GoogleMaterialSymbol
                symbol={givenSymbol}
                SVG_Style={displayClass}
                isFilled={true}
            />
        </div>
        <p id={givenTextID}>
            {givenTitle}
        </p>
    </a>
</template>
