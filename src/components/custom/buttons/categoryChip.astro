---
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";

interface Props {
  givenID: string;
  givenTextID: string;
  givenSVG?: string;
  givenTitle: string;
  givenIsBannerTag?: boolean;
}

const { givenID, givenTextID, givenSVG, givenTitle, givenIsBannerTag } =
  Astro.props;
const displayClass = givenSVG ? "inline-block" : "!hidden";

const regularStyle =
  "flex flex-row items-center justify-center gap-2 py-2 px-4 w-fit h-fit rounded-full bg-Light_Secondary dark:bg-Dark_Secondary hover:bg-Light_Secondary_Hover hover:dark:bg-Dark_Secondary_Hover border border-Light_Border_Primary dark:border-Dark_Border_Primary text-[min(7vw,0.8rem)] !text-Light_Text_Secondary/64 dark:!text-Dark_Text_Secondary/64 hover:!text-Light_Text_Primary dark:hover:!text-Dark_Text_Primary hover:shadow-2xl shadow-Light_Border_Primary dark:shadow-Dark_Border_Primary hover:scale-120 hover:z-1 transition-all duration-250 ease-in-out capitalize";
const bannerStyle =
  "flex flex-row items-center justify-center gap-2 py-2 px-4 w-fit h-fit rounded-full bg-Light_Secondary/32 dark:bg-Dark_Secondary/32 hover:bg-Light_Secondary_Hover/32 hover:dark:bg-Dark_Secondary_Hover/32 border border-Light_Border_Primary dark:border-Dark_Border_Primary text-[min(7vw,0.8rem)] !text-Light_Text_Secondary/64 dark:!text-Dark_Text_Secondary/64 hover:!text-Light_Text_Primary dark:hover:!text-Dark_Text_Primary backdrop-blur-3xl hover:shadow-2xl shadow-Light_Border_Primary dark:shadow-Dark_Border_Primary hover:scale-120 hover:z-1 transition-all duration-250 ease-in-out capitalize";

const Style = givenIsBannerTag ? bannerStyle : regularStyle;
---

<template id={givenID}>
  <a rel="stylesheet" href={givenTitle} class={Style}>
    <GoogleMaterialSymbol
      SVG_Name={givenSVG}
      SVG_Style={displayClass}
      isFilled={true}
    />
    <p id={givenTextID}>
      {givenTitle}
    </p>
  </a>
</template>
