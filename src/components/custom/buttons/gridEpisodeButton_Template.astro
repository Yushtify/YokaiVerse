---
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";
---

<template id="episodeCard_Template">
    <button
        id="episodeCard"
        class="group flex flex-col items-start justify-start gap-4 rounded-3xl p-2 pb-4 min-w-fit w-full min-h-fit h-fit bg-L_Primary dark:bg-D_Primary shadow-2xl shadow-transparent hover:shadow-LB_Primary/48 dark:hover:shadow-DB_Primary/48 hover:-translate-y-4 hover:scale-102 transition-all duration-250 ease-in-out cursor-pointer z-0 hover:z-1"
    >
        <div
            class="relative w-full h-fit aspect-video rounded-3xl rounded-b-xl overflow-hidden"
        >
            <img
                alt="EPISODE_COVER"
                id="episodeCover"
                class="w-full h-fit aspect-video"
            />
            <p
                id="episodeDuration"
                class="absolute bottom-2 right-2 min-w-fit w-fit rounded-3xl p-2 px-4 bg-L_BG dark:bg-D_BG font-bold text-[min(6vw,0.8rem)] text-left capitalize line-clamp-1"
            >
            </p>
        </div>
        <div
            class="flex flex-col items-center justify-center gap-2 px-2 w-full h-fit text-[min(6vw,1rem)] text-LT_Primary dark:text-DT_Primary"
        >
            <div
                class="flex flex-row items-center justify-between w-full h-fit"
            >
                <p
                    id="episodeTitle"
                    class="w-full font-bold text-[min(6vw,1.2rem)] text-left capitalize line-clamp-1"
                >
                </p>
                <p
                    class="flex flex-row items-center justify-center gap-1 min-w-fit w-fit rounded-3xl p-2 px-4 bg-L_BG dark:bg-D_BG font-bold text-[min(6vw,0.8rem)] text-left capitalize line-clamp-1"
                >
                    <span data-i18n="global.variable.episode">Episode</span>
                    <span id="episodeCount"></span>
                </p>
            </div>
            <p
                id="episodeDesc"
                class="w-full text-left text-LT_Secondary dark:text-DT_Secondary line-clamp-2 group-hover:line-clamp-none"
            >
            </p>
        </div>
    </button>
</template>
