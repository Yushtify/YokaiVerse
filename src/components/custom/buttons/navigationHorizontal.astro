---
const currentPath = Astro.url.pathname;

const InactiveTab =
  "flex flex-row items-center justify-center w-fit h-full xl:h-fit max-xl:aspect-square gap-2 rounded-xl p-4 hover:font-semibold text-[min(7vw,1rem)] !text-Light_Text_Secondary/64 dark:!text-Dark_Text_Secondary/64 hover:!text-Accent hover:bg-Light_Primary_Hover dark:hover:bg-Dark_Primary_Hover border border-transparent transition-colors duration-300 ease-in-out overflow-hidden";
const ActiveTab =
  "flex flex-row items-center justify-center w-fit h-full xl:h-fit max-xl:aspect-square gap-2 rounded-xl p-4 font-semibold text-[min(7vw,1rem)] !text-Accent bg-Light_Primary dark:bg-Dark_Primary hover:bg-Light_Primary_Hover dark:hover:bg-Dark_Primary_Hover border border-Accent transition-colors duration-300 ease-in-out overflow-hidden";

const InactiveSVG = "material-symbols-rounded";
const ActiveSVG = "material-symbols-rounded icon-fill";

const isActive = (path: string) => currentPath === path;

interface Props {
  givenSVG: string;
  givenHref: string;
  givenTitle: string; // Görsel yedek metin
  givenData: string; // Siktigimin çeviri anahtarı (örn: "Navbar.Home")
}
const { givenSVG, givenHref, givenTitle, givenData } = Astro.props;
---

<a href={givenHref} class={isActive(givenHref) ? ActiveTab : InactiveTab}>
  <span class={isActive(givenHref) ? ActiveSVG : InactiveSVG}>{givenSVG}</span>

  {/* data-i18n dışarıdan gelen givenData'yı kullanıyor */}
  <p class="max-xl:hidden capitalize" data-i18n={givenData}>
    {givenTitle}
  </p>
</a>
