---
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";

const currentPath = Astro.url.pathname;

const isActive = (path: string) => currentPath === path;

interface Props {
    givenLocationFrom?: "horizontal" | "vertical";
    givenLocation?: "start" | "center" | "end";
    givenSymbol: string;
    givenHref: string;
    givenTitle?: string;
    givenData?: string;
}
const {
    givenLocationFrom,
    givenLocation,
    givenSymbol,
    givenHref,
    givenTitle,
    givenData,
} = Astro.props;

const isTitle = givenTitle ? "" : "hidden";

// validate button rounded
const borderRadiusMap = {
    horizontal: {
        start: "rounded-xl rounded-l-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-r-3xl",
    },
    vertical: {
        start: "rounded-xl rounded-t-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-b-3xl",
    },
} as const;

const borderRadius =
    givenLocationFrom && givenLocation
        ? borderRadiusMap[givenLocationFrom][givenLocation]
        : "rounded-3xl";
const validBorderRadius = `${borderRadius} hover:rounded-3xl`;

const InactiveTab = `relative flex flex-row items-center justify-center w-fit h-fit ${validBorderRadius} gap-2 p-4 md:px-6 bg-L_Primary dark:bg-D_Primary hover:bg-L_Primary_Hover dark:hover:bg-D_Primary_Hover text-[min(6vw,0.9rem)] text-LT_Primary dark:text-DT_Primary transition-all duration-200 ease-in-out`;
const ActiveTab = `relative flex flex-row items-center justify-center w-fit h-fit ${validBorderRadius} gap-2 p-4 md:px-6 bg-Accent hover:bg-Highlight font-bold text-[min(6vw,0.9rem)] text-LT_Inverted dark:text-DT_Inverted transition-all duration-200 ease-in-out`;
---

<a href={givenHref} class={isActive(givenHref) ? ActiveTab : InactiveTab}>
    <GoogleMaterialSymbol
        symbol={givenSymbol}
        SymbolSize="!text-[min(6vw,1.2rem)]"
        isFilled={isActive(givenHref)}
    />
    <p class={`hidden xl:inline capitalize ${isTitle}`} data-i18n={givenData}>
        {givenTitle}
    </p>
</a>
