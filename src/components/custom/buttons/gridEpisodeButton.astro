---
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";

// ensure it's a plain string you can inject into attributes/onclick

interface Props {
  givenVideoID: string;
  VideoRootSRC: string;
  givenVideoTitle: string;
  givenVideoDesc: string;
}

const { givenVideoID, VideoRootSRC, givenVideoTitle, givenVideoDesc } =
  Astro.props;
const CoverIMG = VideoRootSRC + "/cover.webp";
---

<template id="videoCard_Template">
  <button
    id="videoCard"
    class="group flex flex-row lg:flex-col items-start justify-start snap-start w-full h-fit rounded-3xl gap-2 xl:gap-4 hover:-translate-y-2 hover:scale-102 shadow-2xl shadow-transparent hover:shadow-Light_Border_Primary/56 hover:dark:shadow-Dark_Border_Primary/56 transition-shadow-transform duration-250 ease-in-out cursor-pointer"
    onclick={`findAnime('${givenVideoID}')`}
  >
    <div
      class="relative flex flex-col rounded-3xl aspect-video w-full h-fit overflow-hidden"
    >
      <img
        id="episodeCover"
        src={CoverIMG}
        alt="COVER"
        class="rounded-3xl aspect-video w-full h-full border-2 border-Light_Border_Primary dark:border-Dark_Border_Primary"
      />

      <div
        class="absolute top-0 left-0 flex flex-row items-center justify-between gap-4 p-4 pb-0 w-full h-fit"
      >
        <p
          data-videoRootSRC={VideoRootSRC}
          id="videoDuration"
          class="hidden sm:flex flex-row items-center justify-center gap-2 rounded-full p-2 px-4 bg-Light_Secondary dark:bg-Dark_Secondary border border-Light_Border_Primary dark:border-Dark_Border_Primary text-[min(7vw,1rem)] text-Light_Text_Primary dark:text-Dark_Text_Primary"
        >
          <GoogleMaterialSymbol
            SVG_Name="clock"
            SvgSize="!text-[min(7vw,1.5rem)]"
            isFilled={true}
          />
          Duration
        </p>
        <div
          data-videoRootSRC={VideoRootSRC}
          id="episodeCount"
          class="flex flex-row items-center justify-center gap-1 rounded-full p-2 px-4 bg-Light_Secondary dark:bg-Dark_Secondary border border-Light_Border_Primary dark:border-Dark_Border_Primary text-[min(7vw,1rem)] text-Light_Text_Primary dark:text-Dark_Text_Primary capitalize"
        >
          <p id="episodeCount_Text">loading</p>
        </div>
      </div>

      <div
        class="absolute bottom-0 left-0 flex flex-col items-start justify-end p-4 gap-2 w-full h-[45%] group-hover:h-[85%] bg-gradient-to-t from-Light_Border_Primary dark:from-Dark_Border_Primary to-transparent transition-normal duration-250 ease-in-out"
      >
        <div
          class="flex flex-col items-start justify-start gap-1 text-left text-Light_Text_Primary dark:text-Dark_Text_Primary"
        >
          <p
            id="episodeDesc"
            class="opacity-0 group-hover:opacity-100 text-[min(7vw,0.8rem)] text-Light_Text_Secondary dark:text-Dark_Text_Secondary line-clamp-2 lg:line-clamp-3 transition-opacity duration-250 ease-in-out"
          >
            {givenVideoDesc}
          </p>
          <p
            id="episodeTitle"
            class="font-bold text-[min(7vw,1.2rem)] capitalize line-clamp-1"
          >
            {givenVideoTitle}
          </p>
        </div>
      </div>
    </div>
  </button>
</template>
