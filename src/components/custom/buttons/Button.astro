---
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";

interface Props {
    givenLocationFrom?: "horizontal" | "vertical";
    givenLocation?: "start" | "center" | "end";
    givenButtonID: string;
    givenButtonCustomClass?: string;
    givenButtonFill?: boolean;
    givenButtonAction: string;
    givenButtonSymbol?: string;
    givenButtonSymbolSize?: string;
    givenButtonSymbolFill?: boolean;
    givenTitle?: string;
    titleData?: string;
    tooltipTitle?: string;
    tooltipDesc?: string;
    tooltipTitleTrans?: string;
    tooltipDescTrans?: string;
}

const {
    givenLocationFrom,
    givenLocation,

    givenButtonID,
    givenButtonCustomClass,
    givenButtonFill,
    givenButtonAction,
    givenButtonSymbol,
    givenButtonSymbolSize,
    givenButtonSymbolFill,

    givenTitle,
    titleData,

    tooltipTitle,
    tooltipTitleTrans,
    tooltipDesc,
    tooltipDescTrans,
} = Astro.props;

// validate button rounded
const borderRadiusMap = {
    horizontal: {
        start: "rounded-xl rounded-l-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-r-3xl",
    },
    vertical: {
        start: "rounded-xl rounded-t-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-b-3xl",
    },
} as const;

const borderRadius =
    givenLocationFrom && givenLocation
        ? borderRadiusMap[givenLocationFrom][givenLocation]
        : "rounded-3xl";
const validBorderRadius = `${borderRadius} hover:rounded-3xl`;

const isWFill = givenButtonFill ? " w-full min-w-fit " : " min-w-fit w-fit ";

const classMap = {
    buttonClass: `group flex flex-row items-center justify-center px-4 p-2 gap-2 h-fit rounded-full bg-L_Secondary dark:bg-D_Secondary hover:bg-Accent hover:font-semibold text-[min(6vw,0.9rem)] text-LT_Primary dark:text-DT_Primary hover:text-LT_Inverted dark:hover:text-DT_Inverted transition-all duration-200 ease-in-out cursor-pointer ${isWFill} ${validBorderRadius} ${givenButtonCustomClass}`,
};

const ValidSymbolSize = givenButtonSymbolSize
    ? givenButtonSymbolSize
    : "text-[min(6vw,0.9rem)]!";

const isTitleValid = givenTitle ? "flex" : "hidden";
---

<button
    id={givenButtonID}
    class={classMap.buttonClass}
    onclick={givenButtonAction}
    data-tooltip={tooltipDesc}
    data-tooltip-title={tooltipTitle}
    data-tooltip-desc-trans={tooltipDescTrans}
    data-tooltip-title-trans={tooltipTitleTrans}
>
    <GoogleMaterialSymbol
        symbol={givenButtonSymbol}
        SymbolSize={ValidSymbolSize}
        isFilled={givenButtonSymbolFill}
    />
    <p data-i18n={titleData} class={`${isTitleValid}`}>{givenTitle}</p>
</button>
