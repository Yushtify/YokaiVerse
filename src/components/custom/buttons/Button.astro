---
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";

interface Props {
  givenButtonID: string;
  givenButtonCustomClass?: string;
  givenButtonTransparency?: boolean;
  givenButtonFill?: boolean;
  givenButtonAction: string;
  givenButtonSVG?: string;
  givenButtonSVGSize?: string;
  givenButtonSVGFill?: boolean;
}

const {
  givenButtonID,
  givenButtonCustomClass,
  givenButtonTransparency,
  givenButtonFill,
  givenButtonAction,
  givenButtonSVG,
  givenButtonSVGSize,
  givenButtonSVGFill,
} = Astro.props;

const isWFill = givenButtonFill ? " w-full " : " w-fit ";
const transparentBG =
  "group flex flex-row items-center justify-center px-4 p-2" +
  isWFill +
  "h-fit rounded-full hover:bg-Accent hover:font-semibold text-[min(7vw,1rem)] text-Light_Text_Secondary dark:text-Dark_Text_Secondary hover:text-Light_Text_Primary dark:hover:text-Dark_Text_Primary transition-colors duration-300 ease-in-out cursor-pointer";
const BG =
  "group flex flex-row items-center justify-center px-4 p-2" +
  isWFill +
  "h-fit rounded-full bg-Light_Tertiary dark:bg-Dark_Tertiary hover:bg-Accent border border-Light_Border_Primary dark:border-Dark_Border_Primary hover:font-semibold text-[min(7vw,1rem)] text-Light_Text_Secondary dark:text-Dark_Text_Secondary hover:text-Light_Text_Primary dark:hover:text-Dark_Text_Primary transition-colors duration-300 ease-in-out cursor-pointer";

const ButtonClass = givenButtonTransparency
  ? transparentBG + " " + givenButtonCustomClass
  : BG + " " + givenButtonCustomClass;

console.log(ButtonClass);
---

<button id={givenButtonID} class={ButtonClass} onclick={givenButtonAction}>
  <GoogleMaterialSymbol
    SVG_Name={givenButtonSVG}
    SvgSize={givenButtonSVGSize}
    isFilled={givenButtonSVGFill}
  />
</button>
