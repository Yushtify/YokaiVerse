---
// FilterRounded.astro
interface Props {
  givenID: string;
  groupName: string;
}

const { givenID, groupName } = Astro.props;
---

<button
  id={givenID}
  data-group={groupName}
  class="relative flex flex-row items-center justify-start min-w-fit w-fit h-fit gap-2 rounded-xl p-3 text-nowrap font-semibold text-left text-[min(6vw,0.9rem)] text-Light_Text_Secondary/64 dark:text-Dark_Text_Secondary/64 transition-all duration-300 ease-in-out overflow-hidden cursor-pointer capitalize"
  onclick="switchTheFilter(this)"
>
  <slot />
</button>

<script>
  function switchTheFilter(b: HTMLButtonElement) {
    if (!b) return;

    const group = b.getAttribute("data-group");

    const activeClass =
      "relative flex flex-row items-center justify-start min-w-fit w-fit h-fit gap-2 rounded-xl p-3 text-nowrap font-semibold text-left text-[min(6vw,0.9rem)] text-Light_Text_Primary dark:text-Dark_Text_Primary bg-Light_Border_Primary dark:bg-Dark_Border_Primary transition-all duration-300 ease-in-out overflow-hidden cursor-pointer uppercase";
    const deactiveClass =
      "relative flex flex-row items-center justify-start min-w-fit w-fit h-fit gap-2 rounded-xl p-3 text-nowrap font-semibold text-left text-[min(6vw,0.9rem)] text-Light_Text_Secondary/64 dark:text-Dark_Text_Secondary/64 transition-all duration-300 ease-in-out overflow-hidden cursor-pointer capitalize";

    // radio input logic
    if (group) {
      // deactivate the other buttons in same group name
      const groupButtons = document.querySelectorAll(
        `button[data-group="${group}"]`
      );
      groupButtons.forEach((btn) => {
        if (btn !== b) btn.className = deactiveClass;
      });
    }

    // toggle the button had been clicked
    if (b.className === activeClass) {
      b.className = deactiveClass;
    } else {
      b.className = activeClass;
    }
  }
  (window as any).switchTheFilter = switchTheFilter;
</script>
