---
import { hashTransform } from "astro/assets";
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";
import Button from "./Button.astro";

interface Props {
    givenLocationFrom?: "horizontal" | "vertical";
    givenLocation?: "start" | "center" | "end";

    givenTitle: string;
    givenState: boolean;
    givenID: string;
    groupName: string;
    allowDeselect?: boolean;

    titleData?: string;
    givenSymbol?: string;
    givenSymbolSize?: string;
    givenSymbolStyle?: string;
    givenSymbolFill?: boolean;
}

const {
    givenLocationFrom,
    givenLocation,
    givenTitle,
    givenState,
    givenID,
    groupName,
    allowDeselect = false,
    titleData,
    givenSymbol,
    givenSymbolSize,
    givenSymbolStyle,
    givenSymbolFill,
} = Astro.props;

// validate button rounded
const borderRadiusMap = {
    horizontal: {
        start: "rounded-xl rounded-l-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-r-3xl",
    },
    vertical: {
        start: "rounded-xl rounded-t-3xl",
        center: "rounded-xl",
        end: "rounded-xl rounded-b-3xl",
    },
} as const;

const borderRadius =
    givenLocationFrom && givenLocation
        ? borderRadiusMap[givenLocationFrom][givenLocation]
        : "rounded-3xl";
const validBorderRadius = `${borderRadius} hover:rounded-3xl`;

const classMap = {
    buttonDefClass: `relative flex flex-row items-center justify-start ${validBorderRadius} min-w-fit w-fit h-fit gap-2 p-4 bg-L_Primary dark:bg-D_Primary hover:bg-L_Primary_Hover hover:dark:bg-D_Primary_Hover text-nowrap font-semibold text-left text-[min(6vw,0.9rem)] text-LT_Secondary dark:text-DT_Secondary ease-in-out overflow-hidden cursor-pointer capitalize`,
    buttonActiveClass: `relative flex flex-row items-center justify-start ${validBorderRadius} min-w-fit w-fit h-fit gap-2 p-4 text-nowrap font-semibold text-left text-[min(6vw,0.9rem)] text-LT_Inverted dark:text-DT_Inverted bg-Accent hover:bg-Highlight overflow-hidden cursor-pointer uppercase`,
    hasSymbol: givenSymbol ? "inline" : "hidden",
    symbolFilled: givenSymbolFill ? "icon-fill" : "",
};

const initialClass = givenState
    ? classMap.buttonActiveClass
    : classMap.buttonDefClass;

const SymbolSize = givenSymbolSize
    ? givenSymbolSize
    : "text-[min(6vw,0.9rem)]!";

const validStyle = `${classMap.symbolFilled} ${classMap.hasSymbol} ${givenSymbolStyle}`;
---

<button
    id={givenID}
    class={`filter-btn ${initialClass}`}
    data-group={groupName}
    data-active-class={classMap.buttonActiveClass}
    data-deactive-class={classMap.buttonDefClass}
    data-allow-deselect={allowDeselect ? "true" : "false"}
    data-is-active={givenState ? "true" : "false"}
>
    <GoogleMaterialSymbol
        symbol={givenSymbol}
        SymbolSize={SymbolSize}
        SVG_Style={validStyle}
    />
    <p id="title" data-i18n={titleData}>
        {givenTitle}
    </p>
</button>
