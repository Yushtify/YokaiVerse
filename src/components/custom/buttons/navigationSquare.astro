---
const currentPath = Astro.url.pathname;

const InactiveTab =
    "flex flex-row items-center justify-center w-fit h-fit aspect-square gap-2 rounded-3xl p-4 hover:font-semibold text-[min(7vw,1rem)] !text-LT_Secondary/64 dark:!text-DT_Secondary hover:!text-Accent hover:bg-L_Secondary_Hover dark:hover:bg-D_Secondary_Hover transition-colors duration-300 ease-in-out overflow-hidden";
const ActiveTab =
    "flex flex-row items-center justify-center w-fit h-fit aspect-square gap-2 rounded-3xl p-4 font-semibold text-[min(vw,1rem)] !text-Accent hover:!text-Accent bg-L_Primary dark:bg-D_Primary hover:bg-L_Secondary_Hover dark:hover:bg-D_Secondary_Hover border border-LB_Secondary dark:border-DB_Secondary transition-colors duration-300 ease-in-out overflow-hidden";

const isActive = (path: string) => currentPath === path;

interface Props {
    givenSymbol?: string;
    givenImageHref?: string;
    givenHref: string;
}
const { givenSymbol, givenImageHref, givenHref } = Astro.props;

const isSVG = givenSymbol ? " inline" : " !hidden";
const InactiveSVG = "material-symbols-rounded" + isSVG;
const ActiveSVG = "material-symbols-rounded icon-fill " + isSVG;
const isImage = givenImageHref ? "flex" : "hidden";
---

<a href={givenHref} class={isActive(givenHref) ? ActiveTab : InactiveTab}>
    <img class={`w-auto h-7 aspect-auto ${isImage}`} src={givenImageHref} />
    <span translate="no" class={isActive(givenHref) ? ActiveSVG : InactiveSVG}
        >{givenSymbol}</span
    >
</a>
