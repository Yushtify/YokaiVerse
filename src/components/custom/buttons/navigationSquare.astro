---
const currentPath = Astro.url.pathname;

const InactiveTab =
  "flex flex-row items-center justify-center w-fit h-fit aspect-square gap-2 rounded-xl p-4 hover:font-semibold text-[min(7vw,1rem)] !text-Light_Text_Secondary/64 dark:!text-Dark_Text_Secondary/64 hover:!text-Accent hover:bg-Light_Secondary_Hover dark:hover:bg-Dark_Secondary_Hover transition-colors duration-300 ease-in-out overflow-hidden";
const ActiveTab =
  "flex flex-row items-center justify-center w-fit h-fit aspect-square gap-2 rounded-xl p-4 font-semibold text-[min(vw,1rem)] !text-Accent hover:!text-Accent bg-Light_Primary dark:bg-Dark_Primary hover:bg-Light_Secondary_Hover dark:hover:bg-Dark_Secondary_Hover border border-Light_Border_Secondary dark:border-Dark_Border_Secondary transition-colors duration-300 ease-in-out overflow-hidden";

const isActive = (path: string) => currentPath === path;

interface Props {
  givenSVG?: string;
  givenImageHref?: string;
  givenHref: string;
}
const { givenSVG, givenImageHref, givenHref } = Astro.props;

const isSVG = givenSVG ? " inline" : " !hidden";
const InactiveSVG = "material-symbols-rounded" + isSVG;
const ActiveSVG = "material-symbols-rounded icon-fill " + isSVG;
const isImage = givenImageHref ? "flex" : "hidden";
---

<a href={givenHref} class={isActive(givenHref) ? ActiveTab : InactiveTab}>
  <img class={`w-auto h-7 aspect-auto ${isImage}`} src={givenImageHref} />
  <span class={isActive(givenHref) ? ActiveSVG : InactiveSVG}>{givenSVG}</span>
</a>
