---
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";

// ensure it's a plain string you can inject into attributes/onclick

interface Props {
  givenVideoID: string;
  VideoRootSRC: string;
  givenVideoTitle: string;
  givenVideoDesc: string;
}

const { givenVideoID, VideoRootSRC, givenVideoTitle, givenVideoDesc } =
  Astro.props;
const CoverIMG = VideoRootSRC + "/cover.webp";
---

<template id="videoCard_Template">
  <button
    id="videoCard"
    class="group flex flex-row items-start justify-start w-full h-fit max-h-48 rounded-3xl gap-2 xl:gap-4 cursor-pointer"
    onclick={`findAnime('${givenVideoID}')`}
  >
    <img
      id="videoCover"
      src={CoverIMG}
      alt="COVER"
      class="rounded-3xl aspect-video w-auto h-full border-2 border-Light_Border_Primary dark:border-Dark_Border_Primary"
    />

    <div class="flex flex-row items-start justify-start w-full h-fit">
      <div
        class="flex flex-col items-start justify-end p-4 gap-2 w-full h-full"
      >
        <div
          class="flex flex-col items-start justify-start gap-1 text-left text-Light_Text_Primary dark:text-Dark_Text_Primary"
        >
          <p
            id="videoTitle"
            class="font-bold text-[min(7vw,1.2rem)] capitalize line-clamp-1"
          >
            {givenVideoTitle}
          </p>
          <p
            id="videoDesc"
            class="text-[min(7vw,0.8rem)] text-Light_Text_Secondary dark:text-Dark_Text_Secondary line-clamp-3"
          >
            {givenVideoDesc}
          </p>
        </div>
      </div>

      <div
        class="absolute top-0 left-0 flex flex-row items-center justify-between gap-4 p-4 pb-0 w-full h-fit"
      >
        <p
          data-videoRootSRC={VideoRootSRC}
          id="videoDuration"
          class="flex flex-row items-center justify-center gap-2 rounded-full p-2 px-4 bg-Light_Secondary dark:bg-Dark_Secondary border border-Light_Border_Primary dark:border-Dark_Border_Primary text-[min(7vw,1rem)] text-Light_Text_Primary dark:text-Dark_Text_Primary"
        >
          <GoogleMaterialSymbol
            SVG_Name="clock"
            SvgSize="!text-[min(7vw,1.5rem)]"
            isFilled={true}
          />
          Duration
        </p>
        <p
          data-videoRootSRC={VideoRootSRC}
          id="episodeCount"
          class="flex flex-row items-center justify-center gap-1 rounded-full p-2 px-4 bg-Light_Secondary dark:bg-Dark_Secondary border border-Light_Border_Primary dark:border-Dark_Border_Primary text-[min(7vw,1rem)] text-Light_Text_Primary dark:text-Dark_Text_Primary"
        >
          Episode ?
        </p>
      </div>
    </div>
  </button>
</template>
