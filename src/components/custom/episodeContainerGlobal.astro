---
import SeasonSwithcer from "./public/seasonSwithcer.astro";
import EpisodeButton from "./buttons/episodeButton_Template.astro";

interface Props {
    givenID: "anime" | "manga";
    givenWidth?: string;
}
const { givenID, givenWidth } = Astro.props;

let switcherID = "";
let radioID = "";
let radioTemplateID = "";
let containerID = "";
const mainWrapperID = `${givenID}Wrapper`;
if (givenID === "manga") {
    switcherID = `mangaVolumeSwitcher`;
    radioID = `mangaVolumeRadio`;
    radioTemplateID = `${radioID}_Template`;
    containerID = `mangaVolumeWrapper_Template`;
} else if (givenID === "anime") {
    switcherID = `animeSeasonSwitcher`;
    radioID = `animeSeasonRadio`;
    radioTemplateID = `${radioID}_Template`;
    containerID = `animeSeasonWrapper_Template`;
} else {
    console.log(givenID);
}
---

<div
    id={mainWrapperID}
    class={`flex flex-col items-start justify-center gap-4 w-full max-w-screen h-fit ${givenWidth}`}
>
    <p
        data-i18n="global.variable.allEpisodes"
        class="w-full h-fit mx-2 mt-2 font-semibold text-left text-[min(6vw,2rem)] text-LT_Primary dark:text-DT_Primary uppercase"
    >
        All Episodes
    </p>
    <div
        id={switcherID}
        class="grid grid-cols-[repeat(auto-fill,minmax(400px,1fr))] gap-4 w-full h-fit"
    >
    </div>
    <template id={radioTemplateID}>
        <SeasonSwithcer
            givenID={radioID}
            groupName="seasonSwitch"
            givenState={false}
        />
    </template>
</div>

<template id={containerID}>
    <div
        id="Season1_Container"
        class="grid grid-cols-[repeat(auto-fill,minmax(325px,1fr))] gap-4 w-full h-fit"
    >
    </div>
</template>
<EpisodeButton type={givenID} />

<script>
    import "../pageComponents/settings/scripts/settingsControls.ts";
</script>
