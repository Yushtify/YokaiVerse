---
import SeasonSwithcer from "./public/seasonSwithcer.astro";
import VideoButtonTemplate from "./buttons/gridEpisodeButton_Template.astro";
import GoogleMaterialSymbol from "./googleMaterial_Symbol.astro";

interface Props {
    givenWidth?: string;
}
const { givenWidth } = Astro.props;
---

<div
    id="season_main_wrapper"
    class={`flex flex-col items-start justify-center gap-4 w-full max-w-screen h-fit ${givenWidth}`}
>
    <p
        data-i18n="global.variable.allEpisodes"
        class="w-full h-fit mx-2 mt-2 font-semibold text-left text-[min(6vw,2rem)] text-LT_Primary dark:text-DT_Primary uppercase"
    >
        All Episodes
    </p>
    <div
        id="seasonSwitch"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 items-start justify-center gap-4 w-full h-fit"
    >
    </div>
    <template id="SeasonRadioTemplate">
        <SeasonSwithcer
            givenID="seasonSwitcher"
            givenRadGroup="seasonSwitch"
            givenCanDisabled={false}
            givenState={false}
        />
    </template>
</div>

<template id="Season_Container_Template">
    <div
        id="Season1_Container"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 items-start justify-start w-full h-fit gap-4"
    >
    </div>
</template>
<VideoButtonTemplate />
