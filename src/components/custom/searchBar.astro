---
import GoogleMaterialSymbol from "./googleMaterial_Symbol.astro";

const { givenID, givenPlaceHolder, data } = Astro.props;
---

<div
  class="group relative flex flex-row items-center justify-start gap-4 pl-4 p-2 rounded-3xl w-fit h-fit text-[min(7vw,1rem)] text-Light_Text_Secondary dark:text-Dark_Text_Secondary bg-Light_Secondary dark:bg-Dark_Secondary border border-Light_Border_Primary dark:border-Dark_Border_Primary transition-colors ease-in-out duration-300 has-[:focus]:border-Accent has-[:focus]:dark:border-Accent hover:bg-Light_Border_Primary hover:dark:bg-Dark_Border_Primary"
>
  <input
    type="search"
    id={givenID}
    class="peer outline-none w-fit min-w-24 bg-transparent focus:text-Light_Text_Primary focus:dark:text-Dark_Text_Primary"
    placeholder={givenPlaceHolder}
    data-i18n={data}
  />
  <button
    class="flex flex-row items-center justify-center rounded-3xl aspect-square p-2 cursor-pointer transition-all duration-300 peer-focus:bg-Accent peer-focus:text-Light_Text_Primary group-hover:bg-Accent group-hover:text-Light_Text_Primary"
  >
    <GoogleMaterialSymbol SVG_Name="send" SvgSize="!text-[min(7vw,1.5rem)]" />
  </button>
</div>
