---
import GoogleMaterialSymbol from "./googleMaterial_Symbol.astro";

// FilterRounded.astro
interface Props {
    givenGoogleSymbol: string;
    givenTitle: string;
    givenDesc: string;
    titleData: string;
    descData: string;
}

const { givenGoogleSymbol, givenTitle, givenDesc, titleData, descData } =
    Astro.props;

const titleTextSize = "text-[min(6vw,2rem)]";
---

<div
    class="relative flex flex-col items-start justify-center gap-4 my-4 w-full max-w-full h-fit text-LT_Primary dark:text-DT_Primary text-[min(6vw,0.9rem)]"
>
    <div
        class="relative flex flex-col items-start justify-center w-full h-fit gap-2 mb-4 text-left"
    >
        <div
            class="flex flex-row items-center justify-start gap-4 w-full h-fit"
        >
            <button
                onclick="history.back()"
                class="group relative flex flex-row ease-in-out overflow-hidden cursor-pointer"
            >
                <GoogleMaterialSymbol
                    symbol={givenGoogleSymbol}
                    SVG_Style="opacity-100 group-hover:opacity-0 transition-opacity duration-200 ease-in-out"
                    SymbolSize="!text-[min(6vw,2rem)]"
                    isFilled={true}
                />
                <GoogleMaterialSymbol
                    symbol="undo"
                    SVG_Style="absolute top-[50%] left-[50%] translate-x-[-50%] translate-y-[-50%] opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-in-out"
                    SymbolSize="!text-[min(6vw,2rem)]"
                    isFilled={true}
                />
            </button>
            <p
                data-i18n={titleData}
                class="text-[min(6vw,2rem)] font-semibold capitalize"
            >
                {givenTitle}
            </p>
        </div>
        <p
            data-i18n={descData}
            class="text-LT_Secondary dark:text-DT_Secondary mt-2 w-full md:w-[80%] xl:w-[75%]"
        >
            {givenDesc}
        </p>
    </div>

    <slot />
</div>
