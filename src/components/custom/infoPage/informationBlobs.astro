---
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";

interface Props {
  givenID: string;
  givenTextID: string;
  givenSVG?: string;
  givenTitle: string;
  givenInformation: string;
}

const { givenID, givenTextID, givenSVG, givenTitle, givenInformation } =
  Astro.props;

const displayClass = givenSVG ? "inline-block" : "!hidden";
---

<div
  id={givenID}
  class="flex flex-row items-center justify-start p-4 rounded-3xl w-fit h-fit gap-2 hover:bg-Light_Secondary dark:hover:bg-Dark_Secondary text-Light_Text_Primary dark:text-Dark_Text_Primary border border-transparent hover:border-Light_Border_Primary hover:dark:border-Dark_Border_Primary hover:shadow-2xl shadow-Light_Border_Primary/48 dark:shadow-Dark_Border_Primary/48 hover:z-1 hover:scale-110 capitalize transition-all duration-250 ease-in-out"
>
  <GoogleMaterialSymbol
    SVG_Name={givenSVG}
    SVG_Style={displayClass}
    SvgSize="!text-[min(7vw,2rem)]"
    isFilled={true}
  />
  <div
    class="flex flex-col items-start justify-center gap-1 w-full h-full font-bold"
  >
    <p
      class="uppercase text-[min(7vw,0.6rem)] text-Light_Text_Secondary dark:text-Dark_Text_Secondary leading-none"
    >
      {givenTitle}
    </p>
    <p id={givenTextID} class="text-[min(7vw,0.8rem)] leading-none">
      {givenInformation}
    </p>
  </div>
</div>
