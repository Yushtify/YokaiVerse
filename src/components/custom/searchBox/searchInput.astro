---
import GoogleMaterialSymbol from "../googleMaterial_Symbol.astro";

interface Props {
    givenID: string;
    givenPlaceHolder: string;
    data: string;
}

const { givenID, givenPlaceHolder, data } = Astro.props;
---

<div
    class="group relative flex flex-row items-center justify-center gap-4 pl-4 p-2 rounded-3xl min-w-fit w-full h-fit text-[min(6vw,0.9rem)] text-LT_Secondary dark:text-DT_Secondary border-2 border-transparent transition-colors ease-in-out duration-300 has-[:focus]:border-Accent has-[:focus]:dark:border-Accent hover:bg-LB_Primary hover:dark:bg-DB_Primary"
>
    <input
        type="search"
        id={givenID}
        class="peer outline-none w-full bg-transparent focus:text-LT_Primary focus:dark:text-DT_Primary"
        placeholder={givenPlaceHolder}
        data-i18n={data}
    />
    <button
        class="flex flex-row items-center justify-center rounded-3xl aspect-square p-2 cursor-pointer transition-all duration-300 peer-focus:bg-Accent peer-focus:text-LT_Primary group-hover:bg-Accent group-hover:text-LT_Primary"
    >
        <GoogleMaterialSymbol
            symbol="search"
            SymbolSize="!text-[min(6vw,1.5rem)]"
        />
    </button>
</div>
