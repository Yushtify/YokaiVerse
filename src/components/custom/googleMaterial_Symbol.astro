---
interface Props {
    SVG_ID?: string;
    symbol?: string;
    SVG_Style?: string;
    isFilled?: boolean;
    SvgSize?: string;
}
const { SVG_ID, symbol, SVG_Style, isFilled, SvgSize } = Astro.props;

const isActive = symbol ? "inline" : "!hidden";
const ValidSVG_Style = SVG_Style ? SVG_Style : "";
const ValidIsFilled = isFilled ? "icon-fill" : "";
const ValidSize = SvgSize ? SvgSize : "!text-[min(7vw,1rem)]";
const ValidID = SVG_ID ? SVG_ID : "googleSymbol";
---

<span
    translate="no"
    id={ValidID}
    class={`select-none material-symbols-rounded group-hover:icon-fill ${SVG_Style} ${ValidIsFilled} ${ValidSize} ${isActive}`}
>
    {symbol}
</span>
