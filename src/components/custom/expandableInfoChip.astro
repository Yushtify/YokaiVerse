---
interface Props {
  givenID: string;
  givenTextID: string;
  givenTitle?: string;
  givenDesc: string;
}

const { givenID, givenTextID, givenTitle, givenDesc } = Astro.props;
const isTitle = givenTitle ? "inline" : "hidden";
---

<div
  id={givenID}
  onclick={`expandDescription('${givenTextID}')`}
  class="flex flex-col items-center justify-center gap-2 p-4 rounded-xl w-full h-fit bg-Light_Secondary dark:bg-Dark_Secondary text-[min(7vw,1rem)] border border-transparent hover:border-Light_Border_Primary dark:hover:border-Dark_Border_Primary text-Light_Text_Secondary dark:text-Dark_Text_Secondary hover:text-Light_Text_Primary dark:hover:text-Dark_Text_Primary shadow-xl shadow-transparent hover:shadow-Light_Border_Primary/32 dark:hover:shadow-Dark_Border_Primary/32 cursor-pointer transition-all duration-250 ease-in-out"
>
  <p
    class={`font-semibold text-[min(7vw,0.8rem)] w-full h-fit line-clamp-2 uppercase ${isTitle}`}
  >
    {givenTitle}
  </p>
  <p id={givenTextID} class="w-full h-fit line-clamp-2">
    {givenDesc}
  </p>
</div>

<script>
  function expandDescription(ParagraphID?: string) {
    let DescriptionP: HTMLParagraphElement; // Description Paragraph Element
    if (ParagraphID) {
      DescriptionP = document.getElementById(
        ParagraphID,
      ) as HTMLParagraphElement;
    } else {
      DescriptionP = document.getElementById(
        "DescriptionP",
      ) as HTMLParagraphElement;
    }

    // Checking if the Paragraph is valid.
    if (!DescriptionP)
      // The paragraph not valid.
      return console.error("The Description Paragraph not found in the page!");
    else {
      // The Paragraph is valid
      if (DescriptionP.classList.contains("line-clamp-2"))
        DescriptionP.classList.replace("line-clamp-2", "line-clamp-none"); // Expand
      else DescriptionP.classList.replace("line-clamp-none", "line-clamp-2"); // Collapse
    }
  }
  (window as any).expandDescription = expandDescription;
</script>
