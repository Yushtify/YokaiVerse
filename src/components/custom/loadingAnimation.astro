---
import GoogleMaterialSymbol from "./googleMaterial_Symbol.astro";
---

<div
  id="LoadingDIV"
  class="fixed top-0 left-0 hidden flex-col items-center justify-center gap-4 w-full h-full bg-Light_Primary/50 dark:bg-Dark_Primary/50 backdrop-blur-3xl text-[min(7vw,1rem)] text-center text-Light_Text_Primary dark:text-Dark_Text_Primary opacity-0 z-9999"
>
  <GoogleMaterialSymbol
    SVG_Name="progress_activity"
    SVG_ID="SpinningCircle"
    SVG_Style="!font-bold text-Accent"
    SvgSize="!text-[min(7vw,8rem)]"
    isFilled={true}
  />

  <p
    id="AnimatingText"
    class="font-bold text-[min(7vw,2rem)] text-Accent capitalize"
  >
    Loading<span class="dots"></span>
  </p>

  <p class="text-[min(7vw,1rem)] opacity-80">
    Please be patient as systems are working to fetch data, this screen will
    fade away when loaded.
  </p>
  <p id="errorLine_Text" class="text-red-500 text-[min(7vw,0.9rem)] opacity-90">
  </p>
</div>

<script>
  /**
   * Interface defining the structure of the Loading UI elements.
   */
  interface LoadingElements {
    div: HTMLElement | null;
    spin: HTMLElement | null;
    text: HTMLElement | null;
    error: HTMLElement | null;
  }

  /**
   * Global Loading Manager Function.
   * Accessed via window.LoadingManager.show(), etc.
   */
  function LoadingManager() {
    return {
      /**
       * Caches and returns the required DOM elements for the loading screen.
       */
      getElements(): LoadingElements {
        return {
          div: document.getElementById("LoadingDIV"),
          spin: document.getElementById("SpinningCircle"),
          text: document.getElementById("AnimatingText"),
          error: document.getElementById("errorLine_Text"),
        };
      },

      /**
       * Replaces 'hidden' with 'flex' and fades in.
       */
      show(message: string = "Loading"): void {
        const { div, text, error, spin } = this.getElements();

        if (div) {
          // 1. Switch display from hidden to flex
          div.classList.replace("hidden", "flex");

          // 2. Trigger opacity transition after display change
          requestAnimationFrame(() => {
            div.style.opacity = "1";
          });
        }

        if (error) error.innerText = "";

        if (text) {
          text.innerHTML = `${message}<span class="dots"></span>`;
        }

        if (spin) {
          spin.innerText = "progress_activity";
          spin.style.animation = "spin 1.2s linear infinite";
        }
      },

      /**
       * Transitions into an error state.
       */
      setError(errorMessage: string): void {
        const { error, spin, text } = this.getElements();

        if (error) {
          error.innerText = errorMessage;
        }

        if (spin) {
          spin.innerText = "error";
          spin.style.animation = "none";
        }

        if (text) {
          text.innerHTML = "Error Occurred";
        }
      },

      /**
       * Fades out and replaces 'flex' with 'hidden' after animation ends.
       */
      hide(): void {
        const { div } = this.getElements();

        if (div) {
          div.style.transition = "opacity 0.5s ease";
          div.style.opacity = "0";

          // Wait for the fade animation to complete
          const handleEnd = (event: TransitionEvent) => {
            if (event.propertyName === "opacity") {
              div.classList.replace("flex", "hidden");
              div.removeEventListener("transitionend", handleEnd);
            }
          };

          div.addEventListener("transitionend", handleEnd);
        }
      },
    };
  }

  // Attach the execution of the function to the window to make it truly global
  (window as any).LoadingManager = LoadingManager();
</script>
