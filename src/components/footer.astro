---
import DropdownMenu from "./custom/dropdownMenu.astro";
import LinkButton from "./custom/links/linkButton.astro";
import LanguageSwitcher from "./custom/public/languageSwitcher.astro";
---

<footer
    class="flex flex-col items-center justify-center w-screen h-fit gap-12 pb-0 p-8 md:p-12 md:px-36 lg:px-48 xl:px-58 bg-L_Primary dark:bg-D_Primary"
>
    <div
        class="flex flex-col items-start justify-between w-full lg:w-full h-fit gap-12 text-LT_Primary dark:text-DT_Primary"
    >
        <div
            class="flex flex-row items-center justify-start w-full h-fit gap-4 p-4 pr-8 rounded-3xl bg-L_BG dark:bg-D_BG text-Accent"
        >
            <img
                src="/logo.svg"
                alt="YOKAIVERSE LOGO"
                class="h-24 aspect-square dark:hidden"
            />
            <img
                src="/logo_d.svg"
                alt="YOKAIVERSE LOGO"
                class="h-24 aspect-square hidden dark:inline"
            />
            <div
                class="flex flex-col items-start justify-center gap-2 w-fit h-fit"
            >
                <p
                    class="font-bold text-[min(6vw,1.6rem)]"
                    data-i18n="footer.brand"
                >
                    YokaiVerse
                </p>
                <p
                    class="w-full text-[min(6vw,0.9rem)] text-LT_Secondary dark:text-DT_Secondary"
                    data-i18n="footer.slogan"
                >
                    Your privacy is our goal to keep it safe and secure.
                </p>
            </div>
        </div>
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 items-start justify-between gap-12 w-full h-fit"
        >
            <div
                class="flex flex-col items-start justify-start w-fit h-fit gap-4"
            >
                <p
                    class="font-semibold text-[min(6vw,1.2rem)]"
                    data-i18n="footer.sections.links.title"
                >
                    Links
                </p>
                <div
                    class="flex flex-col items-start sm:items-start justify-start w-fit h-fit gap-4 overflow-hidden capitalize"
                >
                    <LinkButton
                        givenID="aboutF_Link"
                        givenHREF="/register"
                        dataTranslation="footer.sections.links.support"
                    >
                        support us
                    </LinkButton>
                    <LinkButton
                        givenID="aboutF_Link"
                        givenHREF="/store"
                        dataTranslation="footer.sections.links.store"
                    >
                        store
                    </LinkButton>
                    <LinkButton
                        givenID="aboutF_Link"
                        givenHREF="/register"
                        dataTranslation="footer.sections.links.register"
                    >
                        register
                    </LinkButton>
                    <LinkButton
                        givenID="aboutF_Link"
                        givenHREF="/login"
                        dataTranslation="footer.sections.links.login"
                    >
                        login
                    </LinkButton>
                    <LinkButton
                        givenID="aboutF_Link"
                        givenHREF="/changelog"
                        dataTranslation="footer.sections.links.whats_new"
                    >
                        whats new
                    </LinkButton>
                    <LinkButton
                        givenID="aboutF_Link"
                        givenHREF="/roadmap"
                        dataTranslation="footer.sections.links.road_map"
                    >
                        whats next
                    </LinkButton>
                </div>
            </div>

            <div
                class="flex flex-col items-start justify-start w-fit h-fit gap-4"
            >
                <p
                    class="font-semibold text-[min(6vw,1.2rem)]"
                    data-i18n="footer.sections.community.title"
                >
                    Community
                </p>
                <div
                    class="flex flex-col items-start sm:items-start justify-start w-fit h-fit gap-4 overflow-hidden capitalize"
                >
                    <LinkButton
                        givenID="aboutF_Link"
                        givenHREF="/forum"
                        dataTranslation="footer.sections.community.forums"
                    >
                        forums
                    </LinkButton>
                </div>
            </div>

            <div
                class="flex flex-col items-start justify-start w-fit h-fit gap-4"
            >
                <p
                    class="font-semibold text-[min(6vw,1.2rem)]"
                    data-i18n="footer.sections.company.title"
                >
                    Company
                </p>
                <div
                    class="flex flex-col items-start sm:items-start justify-start w-fit h-fit gap-4 overflow-hidden capitalize"
                >
                    <LinkButton
                        givenID="aboutF_Link"
                        givenHREF="/doc/about"
                        dataTranslation="footer.sections.company.about"
                    >
                        About Us
                    </LinkButton>
                    <LinkButton
                        givenID="aboutF_Link"
                        givenHREF="/doc/blog"
                        dataTranslation="footer.sections.company.blog"
                    >
                        blog
                    </LinkButton>
                    <LinkButton
                        givenID="aboutF_Link"
                        givenHREF="/doc"
                        dataTranslation="footer.sections.company.docs"
                    >
                        documentation
                    </LinkButton>
                    <LinkButton
                        givenID="aboutF_Link"
                        givenHREF="/doc/terms"
                        dataTranslation="footer.sections.company.terms"
                    >
                        terms of usage
                    </LinkButton>
                    <LinkButton
                        givenID="aboutF_Link"
                        givenHREF="/doc/privacy"
                        dataTranslation="footer.sections.company.privacy"
                    >
                        privacy and policy
                    </LinkButton>
                </div>
            </div>
        </div>
    </div>

    <div
        class="flex flex-col md:flex-row items-start md:items-end justify-start pb-4 w-full h-fit gap-4"
    >
        <LanguageSwitcher />
    </div>
</footer>
