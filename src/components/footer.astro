---
import GoogleMaterialSymbol from "./custom/googleMaterial_Symbol.astro";
import LinkButton from "./custom/links/linkButton.astro";
---

<footer
  class="flex flex-col items-center justify-center w-screen h-fit gap-12 pb-0 p-8 px-8 md:px-36 lg:px-48 xl:px-58"
>
  <div
    class="flex flex-col xl:flex-row items-start justify-between w-full lg:w-full h-fit gap-12 text-Light_Text_Primary dark:text-Dark_Text_Primary"
  >
    <div class="flex flex-col items-start justify-start gap-4 w-fit h-fit">
      <div
        class="flex flex-col items-start justify-start w-fit h-fit gap-1 text-Accent"
      >
        <p class="font-bold text-[min(7vw,1.6rem)]" data-i18n="Footer.brand">
          YokaiVerse
        </p>
        <p
          class="text-[min(7vw,0.9rem)] opacity-65 text-nowrap"
          data-i18n="Footer.slogan"
        >
          Your privacy is our goal to keep it safe and secure.
        </p>
      </div>
    </div>
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 items-start justify-between gap-12 w-full h-fit"
    >
      <div class="flex flex-col items-start justify-start w-fit h-fit gap-4">
        <p
          class="font-semibold text-[min(7vw,1.2rem)]"
          data-i18n="Footer.Sections.Links.title"
        >
          Links
        </p>
        <div
          class="flex flex-col items-start sm:items-start justify-start w-fit h-fit gap-4 overflow-hidden capitalize"
        >
          <LinkButton
            givenID="aboutF_Link"
            givenHREF="/register"
            dataTranslation="Footer.Sections.Links.support"
          >
            support us
          </LinkButton>
          <LinkButton
            givenID="aboutF_Link"
            givenHREF="/store"
            dataTranslation="Footer.Sections.Links.store"
          >
            store
          </LinkButton>
          <LinkButton
            givenID="aboutF_Link"
            givenHREF="/register"
            dataTranslation="Footer.Sections.Links.register"
          >
            register
          </LinkButton>
          <LinkButton
            givenID="aboutF_Link"
            givenHREF="/login"
            dataTranslation="Footer.Sections.Links.login"
          >
            login
          </LinkButton>
          <LinkButton
            givenID="aboutF_Link"
            givenHREF="/whats-new"
            dataTranslation="Footer.Sections.Links.whats_new"
          >
            whats new
          </LinkButton>
        </div>
      </div>

      <div class="flex flex-col items-start justify-start w-fit h-fit gap-4">
        <p
          class="font-semibold text-[min(7vw,1.2rem)]"
          data-i18n="Footer.Sections.Community.title"
        >
          Community
        </p>
        <div
          class="flex flex-col items-start sm:items-start justify-start w-fit h-fit gap-4 overflow-hidden capitalize"
        >
          <LinkButton
            givenID="aboutF_Link"
            givenHREF="/forum"
            dataTranslation="Footer.Sections.Community.forums"
          >
            forums
          </LinkButton>
        </div>
      </div>

      <div class="flex flex-col items-start justify-start w-fit h-fit gap-4">
        <p
          class="font-semibold text-[min(7vw,1.2rem)]"
          data-i18n="Footer.Sections.Company.title"
        >
          Company
        </p>
        <div
          class="flex flex-col items-start sm:items-start justify-start w-fit h-fit gap-4 overflow-hidden capitalize"
        >
          <LinkButton
            givenID="aboutF_Link"
            givenHREF="/doc/about"
            dataTranslation="Footer.Sections.Company.about"
          >
            About Us
          </LinkButton>
          <LinkButton
            givenID="aboutF_Link"
            givenHREF="/doc/blog"
            dataTranslation="Footer.Sections.Company.blog"
          >
            blog
          </LinkButton>
          <LinkButton
            givenID="aboutF_Link"
            givenHREF="/doc"
            dataTranslation="Footer.Sections.Company.docs"
          >
            documentation
          </LinkButton>
          <LinkButton
            givenID="aboutF_Link"
            givenHREF="/doc/terms"
            dataTranslation="Footer.Sections.Company.terms"
          >
            terms of usage
          </LinkButton>
          <LinkButton
            givenID="aboutF_Link"
            givenHREF="/doc/privacy"
            dataTranslation="Footer.Sections.Company.privacy"
          >
            privacy and policy
          </LinkButton>
        </div>
      </div>
    </div>
  </div>

  <div class="flex flex-row items-center justify-start w-full h-fit gap-4">
    <button
      id="languageSwitch"
      onclick="window.switchLanguage()"
      class="flex flex-row items-center justify-start w-fit h-fit max-xl:aspect-square gap-2 rounded-3xl p-4 hover:font-semibold text-[min(7vw,1rem)] text-Light_Text_Secondary dark:text-Dark_Text_Secondary hover:text-Accent hover:bg-Light_Secondary_Hover dark:hover:bg-Dark_Secondary_Hover transition-colors duration-300 ease-in-out overflow-hidden cursor-pointer"
    >
      <span class="material-symbols-rounded">translate</span>
      <p id="languageSwitch_Text" class="font-semibold uppercase">en</p>
    </button>
  </div>
</footer>
